# Travel-node graph (issue #32).
#
# The travel graph is the long-distance counterpart to the mmap pathfinder: the core's
# PathGenerator only returns useful paths up to a few hundred yards, so without a graph a bot
# asked to cross a continent just walks into the first mountain. With this enabled the server
# builds a graph of flight masters, inns, spirit healers, instance portals, boats/zeppelins,
# player start locations and zone centres, links them with real walkable paths, and routes bots
# over it (A*), including taking flight paths and transports.
#
# The graph is stored in the playerbots database (playerbots_travelnode / _link / _path). It is
# generated from the live 5.4.8 game data the first time it is needed - that generation is slow
# (minutes to hours, depending on how many maps have mmaps) and blocks startup, but it only
# happens once: later boots load the stored graph. Regeneration is triggered automatically when
# the stored data was produced by an older generator.
#
# Default: 0 (disabled)
AiPlayerbot.EnableTravelNodes = 0

# Distance (yards) beyond which bots route through the travel graph instead of heading straight
# at the destination. Shorter moves stay on the plain mmap pathfinder, which is cheaper.
# Default: 500
AiPlayerbot.TravelNodeRouteDistance = 500

# Quest items to keep in bots' inventories (do not automatically destroy)
AiPlayerbot.RandomBotQuestItems = "5175,5176,5177,5178,6948,11000,12382,13704,16309"

#
#
#
####################################################################################################

####################################################################################################
# SPELLS
#
#

# Randombots automatically learn class quest reward spells on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoLearnQuestSpells = 1

# Randombots automatically learn trainable spells on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoLearnTrainerSpells = 1

# Alt bots (characters of a bot account) learn their class spells like a player: when a class trainer of their class
# is within AltBotTrainerRange yards and they are out of combat and outside instances, they walk to it and pay for
# what they can afford; otherwise they tell their master once per level that they have spells to train.
# Default: 1 (enabled)
AiPlayerbot.AltBotsVisitTrainers = 1

# How far an alt bot walks to a trainer it can see, in yards.
# Default: 100
AiPlayerbot.AltBotTrainerRange = 100

# Random bots learn their professions like a player (BT-197): the factory only picks the pair; when a trainer of one of
# those professions (or of a secondary skill) is within AltBotTrainerRange yards, they walk to it and pay for each rank
# they can afford. Their skill rises only by gathering and crafting. With 0 random bots never learn a profession.
# Default: 1 (enabled)
AiPlayerbot.RandomBotsVisitTrainers = 1

# Random bots buy gear upgrades for their spec at the vendor they visit to sell, repair or buy food and drink, with
# their own money (gear budget only, repairs come first), and equip them. Parity item 4.
# Default: 1 (enabled)
AiPlayerbot.RandomBotsShopForGear = 1

# Alt bots pick their specialization at level 10 and a talent in each newly unlocked tier on their own, at level-up and
# when they log in (a tier the owner already chose is kept). Glyphs and gear are not handed out.
# Default: 1 (enabled)
AiPlayerbot.AltBotsPickTalents = 1

# Alt bots buy gear upgrades for their spec like a player: when a vendor within AltBotVendorRange yards sells one they
# can pay for with their own money, currency or reputation, and they and their master are out of combat and outside
# instances, they walk to it, buy and equip it, and say what they bought (design decision 0021).
# Default: 1 (enabled)
AiPlayerbot.AltBotsShopForGear = 1

# Alt bots craft gear upgrades for their spec with the recipes they know and the reagents they carry, when they stand
# where the recipe can be made (anvil, forge, tools); the item is equipped like loot (design decision 0021).
# Default: 1 (enabled)
AiPlayerbot.AltBotsCraftGear = 1

# How far an alt bot walks to a vendor it can see, in yards.
# Default: 60
AiPlayerbot.AltBotVendorRange = 60

# The group's tank pulls the target marked with its raid mark (skull unless told otherwise) once the whole group is
# ready: everyone alive, out of combat, within MarkPullRange yards, at 60% health and 50% mana or more.
# Default: 1 (enabled)
AiPlayerbot.TankPullsMarks = 1

# Skill tiers of the random bots: every bot has a fixed tier, derived from its GUID. ExpertPercent play their whole
# class sheet and react at once, GoodPercent leave out the expert lines and react a little late, the rest are casual:
# the core lines only, and slow. The delays are added to every decision of the bot, in milliseconds (a random value
# between Min and Max each time). Alt bots have no tier; battlegrounds play the tiers (BT-153); in a match of the arena
# ladder (AiPlayerbot.ArenaTeams.*) a bot plays at its team's tier, the weakest member's (BT-154); other arena bots have
# no tier. Enable = 0 turns it off.
# Default: 1 / 10 / 60 / 0 to 0 / 150 to 400 / 400 to 900
AiPlayerbot.SkillTiers.Enable = 1
AiPlayerbot.SkillTiers.ExpertPercent = 10
AiPlayerbot.SkillTiers.GoodPercent = 60
AiPlayerbot.SkillTiers.ExpertDelayMinMs = 0
AiPlayerbot.SkillTiers.ExpertDelayMaxMs = 0
AiPlayerbot.SkillTiers.GoodDelayMinMs = 150
AiPlayerbot.SkillTiers.GoodDelayMaxMs = 400
AiPlayerbot.SkillTiers.CasualDelayMinMs = 400
AiPlayerbot.SkillTiers.CasualDelayMaxMs = 900

# Dead bots in a human-led dungeon or raid wait for a plausible resurrection for this many
# seconds after all living group members leave combat. The second limit starts at death and
# also applies during combat. Zero makes the corresponding limit immediate.
AiPlayerbot.DungeonReleaseWaitSeconds = 60
AiPlayerbot.DungeonReleaseMaxWaitSeconds = 300

# In a dungeon (not a raid) the bots of a real player walk behind the player along the way the player walked: the
# tank first, healers last, 3 to 10 yards back, each with a fixed small step to the side. Off: the ring of bots
# around the leader that is used everywhere else. In combat the bots position as before.
# Default: 1 (enabled)
AiPlayerbot.DungeonTrailFollow = 1

# In a dungeon group a healer or caster bot drinks between pulls when its mana is below this percentage (nobody of
# the group in combat). Outside dungeons the bots keep drinking at AiPlayerbot.LowMana. 0 turns it off.
# Default: 50
AiPlayerbot.DungeonDrinkMana = 50

# A bot protects a group member who is about to die (BT-129): when an enemy is attacking a member whose health is below 30
# percent (a tank: below 10 percent) the "protect party member" edges fire: Pain Suppression, Intervene and Hand of
# Protection (never on a tank) go to that member, and the monk's Life Cocoon fires on the same edge. 0 turns the value off,
# as it was before the repair.
# Default: 1
AiPlayerbot.ProtectPartyMember = 1

# How far from the tank a marked target may be, and its group members, for the tank to pull it, in yards.
# Default: 40
AiPlayerbot.MarkPullRange = 40

# Randombots automatically picks talent points on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoPickTalents = 1

# Spells every random bot will learn on randomize (54197 - cold weather flying)
AiPlayerbot.RandomBotSpellIds = "54197"

#
#
#
####################################################################################################

####################################################################################################
# PROFESSIONS
#

# Percentage of randombots in each class bucket that receive a class-matching
# weighted profession combination. The remaining randombots use the weighted
# random sane-pair profession pool.
# Default: 30
AiPlayerbot.ClassMatchingProfessionChance = 30

# Automatically adds the 'master fishing' strategy to bots that have the fishing skill when the bots master fishes.
# Default: 1 (Enabled)
AiPlayerbot.EnableFishingWithMaster = 1

#
#
#
####################################################################################################

####################################################################################################
# STRATEGIES
#
#

# Additional randombot strategies
# Strategies added here are applied to all randombots, in addition (or subtraction) to spec/role-based default strategies.
# These rules are processed after the defaults.
# Example: "+threat,-potions"
AiPlayerbot.RandomBotCombatStrategies = ""
# AiPlayerbot.RandomBotNonCombatStrategies = "+grind,+loot,+rpg,+custom::say"
AiPlayerbot.RandomBotNonCombatStrategies = ""
AiPlayerbot.CombatStrategies = ""
AiPlayerbot.NonCombatStrategies = ""

# #817 (AC playerbots.conf.dist:1387-1394). Remove "healer dps" strategy on the maps specified below.
# Default: 1 (enabled)
AiPlayerbot.HealerDPSMapRestriction = 1

# List of Map IDs where "healer dps" strategy will be removed if AiPlayerbot.HealerDPSMapRestriction is enabled
# Default: AC's list (Dungeon and Raid maps) followed by the beyond-AC Cata/MoP 5-man maps
# beyond-AC ids (appended to the AC list below): 568,643,644,645,657,670,725,755,859,938,939,940,959,960,961,962,994,1011
# AC original list: 33,34,36,43,47,48,70,90,109,129,209,229,230,329,349,389,429,1001,1004,1007,269,540,542,543,545,546,547,552,553,554,555,556,557,558,560,585,574,575,576,578,595,599,600,601,602,604,608,619,632,650,658,668,409,469,509,531,532,534,544,548,550,564,565,580,249,533,603,615,616,624,631,649,724
AiPlayerbot.RestrictedHealerDPSMaps = "33,34,36,43,47,48,70,90,109,129,209,229,230,329,349,389,429,1001,1004,1007,269,540,542,543,545,546,547,552,553,554,555,556,557,558,560,585,574,575,576,578,595,599,600,601,602,604,608,619,632,650,658,668,409,469,509,531,532,534,544,548,550,564,565,580,249,533,603,615,616,624,631,649,724,568,643,644,645,657,670,725,755,859,938,939,940,959,960,961,962,994,1011"

#
#
#
####################################################################################################

####################################################################################################
# TELEPORTS
#
#

# Maps where bots can be teleported to
AiPlayerbot.RandomBotMaps = 0,1,530,571

# Probabilty bots teleport to banker (city)
# default: 0.25
AiPlayerbot.ProbTeleToBankers = 0.25

# Control probability weights for bots teleporting to Capital city bankers
# Sum of weights need not be 100. Set to 0 to disable teleporting to the city.
# (#537: ported from AC conf.dist, which ships it on; TravelMgr.cpp reads these keys, default off when absent)
AiPlayerbot.EnableWeightTeleToCityBankers = 1
AiPlayerbot.TeleToStormwindWeight = 2
AiPlayerbot.TeleToIronforgeWeight = 1
AiPlayerbot.TeleToDarnassusWeight = 1
AiPlayerbot.TeleToExodarWeight = 1
AiPlayerbot.TeleToOrgrimmarWeight = 2
AiPlayerbot.TeleToUndercityWeight = 1
AiPlayerbot.TeleToThunderBluffWeight = 1
AiPlayerbot.TeleToSilvermoonCityWeight = 1
AiPlayerbot.TeleToShattrathCityWeight = 1
AiPlayerbot.TeleToDalaranWeight = 1

# How far random bots are teleported after death
AiPlayerbot.RandomBotTeleportDistance = 100

# How many levels below the lowest-level creature in a zone, can a bot be
# This will have no effect if AiPlayerbot.EnableNewRpgStrategy is enabled
# Default: 1 (randombot will leave if they are more than 1 level lower)
AiPlayerbot.RandomBotTeleLowerLevel = 1

# How many levels above the highest-level creature in a zone, can a bot be
# This will have no effect if AiPlayerbot.EnableNewRpgStrategy is enabled
# Default: 3 (randombot will leave if they are more than 3 levels higher)
AiPlayerbot.RandomBotTeleHigherLevel = 3

# Bots automatically teleport to another place for leveling on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoTeleportForLevel = 1

#
#
#
####################################################################################################

####################################################################################################
# BATTLEGROUNDS & ARENAS & PVP
#
#

# Let random bots queue for battlegrounds, accept the invitation and enter the match (issue #33).
#
# Bots queue, enter, walk to their start position and play the objective: Warsong Gulch and Twin
# Peaks (flag carrying), Arathi Basin and Eye of the Storm (node capture). Battlegrounds with no
# ported tactics - Alterac Valley, Isle of Conquest and the Mists/Cataclysm maps - still get the
# shared objective layer, so bots enter and move but do not play those maps well.
#
# Arenas (#437): 5.4.8 has no arena teams (patch 5.4.0). A random bot gathers a party of its own faction
# and bracket and queues the rated 2v2/3v3/5v5 bracket; each player's rating is kept per bracket in
# characters.rated_pvp_info (slot 0/1/2). Bots fill a rated bracket a real player is waiting in, and with
# RandomBotAutoJoinBG they also keep the configured number of rated matches going (arena keys below).
#
# Default: 1 (enabled)
AiPlayerbot.RandomBotJoinBG = 1

# How often (seconds) the battleground queue census runs.
#
# Bots decide whether to fill a queue only from this census, so it is also the worst-case delay
# before a waiting player's queue starts getting bots. That matters more the bigger the
# battleground: Warsong Gulch needs 10 a side and pops in seconds, Arathi Basin needs 15 and was
# measured taking over three minutes at 30 s. Lower it to make queues pop sooner, at the cost of
# running the census more often. Upstream AzerothCore uses 35.
#
# Default: 30
AiPlayerbot.BgCheckInterval = 30

# Log battleground bots that remain in one place for over 30 seconds.
AiPlayerbot.BgIdleLog = 0

# Strand of the Ancients - beyond AC (AC has no SotA tactics; owner 2026-10-14, #736): the chance (0-100) that a
# demolisher gets a bot driver at all. One deterministic roll per vehicle per life (a destroyed and respawned
# demolisher rolls again); a demolisher that loses the roll is left for a player to drive. The harness verb
# `.botscenario - sotadrive <pct>|off` overrides it for a test (off = back to this key).
#
# Default: 70
AiPlayerbot.BgSotaVehicleDriveChance = 70

# Outdoor battlefields (Wintergrasp, Tol Barad) - beyond AC. A random bot that is already in the zone always joins the
# war. With RandomBotJoinBattlefield = 1 bots also travel there: up to RandomBotJoinBattlefieldCount eligible random
# bots per faction queue for an upcoming (15 minutes or less) or running battle, are taken to a graveyard their team
# holds when it starts, and go back to roaming when it ends.
#
# Default: 0 (disabled)
AiPlayerbot.RandomBotJoinBattlefield = 0

# Bots per faction sent to a battlefield by the setting above.
#
# Default: 40
AiPlayerbot.RandomBotJoinBattlefieldCount = 40

# Let bots open battleground queues themselves, so matches still form on a realm with no human
# players waiting. Requires RandomBotJoinBG. As on AC, nothing is seeded until every random bot is
# logged in (#582).
#
# This also controls how *concentrated* bots are. Without it they only fill queues somebody is
# already in; with 300 bots spread over every level bracket of every battleground, no single
# queue ever reaches the players-per-team a match needs. The bracket lists below say which
# (battleground, bracket) pairs to keep a queue open in, so bots converge on those.
#
# Brackets are PvPDifficultyEntry::RangeIndex OF THAT BATTLEGROUND'S MAP (#304): the index restarts at 0
# at each map's lowest level, so the same number is a different level range per battleground - see
# "Battleground bracket ids on 5.4.8" below. Leave a list empty to not auto-open that battleground.
# Counts are how many simultaneous instances to keep going.
#
# Example - keep one level-90 Warsong Gulch, Arathi Basin, Alterac Valley and Strand running:
#   AiPlayerbot.RandomBotAutoJoinBG = 1
#   AiPlayerbot.RandomBotAutoJoinWSBrackets = 16
#   AiPlayerbot.RandomBotAutoJoinABBrackets = 16
#   AiPlayerbot.RandomBotAutoJoinAVBrackets = 9
#   AiPlayerbot.RandomBotAutoJoinSABrackets = 5
#
# Default: 0 (disabled)
AiPlayerbot.RandomBotAutoJoinBG = 0
# #304: WS/AB/EY are AC's level-80 brackets (AC conf.dist: WS 7, AB 6, EY 2) translated to 5.4.8 ids (80-84),
# like IC/AV/SA below. TP is MoP-only and has no 80-84 bracket, so it stays closed unless set.
AiPlayerbot.RandomBotAutoJoinWSBrackets = 14
AiPlayerbot.RandomBotAutoJoinTPBrackets = ""
AiPlayerbot.RandomBotAutoJoinABBrackets = 14
AiPlayerbot.RandomBotAutoJoinEYBrackets = 9
# Old (pre-#304) spelling of the WS/TP/AB/EY counts. Still read, but only when the AC-named
# RandomBotAutoJoinBG<bg>Count key further down is absent; set the AC key instead.
AiPlayerbot.RandomBotAutoJoinWSCount = 1
AiPlayerbot.RandomBotAutoJoinTPCount = 1
AiPlayerbot.RandomBotAutoJoinABCount = 1
AiPlayerbot.RandomBotAutoJoinEYCount = 1

# Required Configuration for RandomBotAutoJoinBG
#
# Known issue: When enabling a lot of brackats in combination with multiple instances,
#              can lead to more instances created by bots than intended (over-queuing).
#
# This section controls the level brackets and 
# automatic bot participation in battlegrounds and arenas.
#
# Brackets:
# - Specify the level ranges for bots to auto-join:
#   - Warsong Gulch (WS): 0 = 10-19, 1 = 20-29, 2 = 30-39, ..., 7 = 80 (default: 7)
#   - Rated Arena: 0 = 10-14, 1 = 15-19, ..., 14 = 80-84 (default: 14)
# - Multiple brackets can be specified as a comma-separated list (e.g., "0,2,5").
#
# Counts:
# - Specify the number of Battlegrounds to auto-fill per bracket.
# - For battlegrounds, Count is the number of bots per bracket. For example:
#   - Warsong Gulch Count = 1 adds 20 bots (10 per team).
# - Ensure there are enough eligible bots to meet the specified counts.
#
# Arena Considerations:
# - Rated Arena brackets default to level 80-84 (bracket 14).
# - Custom code changes are required for lower-level arena brackets to function properly.
#
# Battleground bracket range possibilities (AC 3.3.5 numbering - NOT valid on 5.4.8, see below):
# AiPlayerbot.RandomBotAutoJoinICBrackets = 0,1
# AiPlayerbot.RandomBotAutoJoinEYBrackets = 0,1,2
# AiPlayerbot.RandomBotAutoJoinAVBrackets = 0,1,2,3
# AiPlayerbot.RandomBotAutoJoinABBrackets = 0,1,2,3,4,5,6
# AiPlayerbot.RandomBotAutoJoinWSBrackets = 0,1,2,3,4,5,6,7
#
# Battleground bracket ids on 5.4.8 (#304; PvpDifficulty.dbc RangeIndex per map, read 2026-10-09):
#   WS (489), AB (529): 0 = 10-14, +1 per 5 levels ... 14 = 80-84, 15 = 85-89, 16 = 90
#   AV (30):            0 = 45-49 ... 7 = 80-84, 8 = 85-89, 9 = 90
#   EY (566):           0 = 35-39 ... 9 = 80-84, 10 = 85-89, 11 = 90
#   SA (607):           0 = 65-69 ... 3 = 80-84, 4 = 85-89, 5 = 90
#   IC (628):           0 = 75-79, 1 = 80-84, 2 = 85-89, 3 = 90
#   TP (726), BFG (761): 0 = 85-89, 1 = 90
#   TOK (998), SM (727), DG (1105): 0 = 90 only
# A bracket id the map does not have is never matched by any bot (no queue opens).
#
# The defaults below are AC's level-80 brackets (AC: IC 1, AV 3 = level 80) translated to the same
# level here, so a seeded match is the 80-84 one on both servers. SA is MoP-only and follows them.
AiPlayerbot.RandomBotAutoJoinICBrackets = 1
AiPlayerbot.RandomBotAutoJoinAVBrackets = 7
AiPlayerbot.RandomBotAutoJoinSABrackets = 3
# Cataclysm/Mists battlegrounds (MoP-only, #304; AC has no counterpart): Battle for Gilneas, Temple of
# Kotmogu, Silvershard Mines (SM), Deepwind Gorge. None has an 80-84 bracket, so they stay closed unless set
# (e.g. level 90: BFG 1, TOK 0, SM 0, DG 0).
AiPlayerbot.RandomBotAutoJoinBFGBrackets = ""
AiPlayerbot.RandomBotAutoJoinTOKBrackets = ""
AiPlayerbot.RandomBotAutoJoinSMBrackets = ""
AiPlayerbot.RandomBotAutoJoinDGBrackets = ""

# Battlegrounds count (per bracket!):
AiPlayerbot.RandomBotAutoJoinBGICCount = 0
AiPlayerbot.RandomBotAutoJoinBGEYCount = 1
AiPlayerbot.RandomBotAutoJoinBGAVCount = 0
AiPlayerbot.RandomBotAutoJoinBGSACount = 1
AiPlayerbot.RandomBotAutoJoinBGABCount = 1
AiPlayerbot.RandomBotAutoJoinBGWSCount = 1
# Twin Peaks and the other MoP-only battlegrounds, AC's key spelling (default 1, like AC's WS/AB/EY).
AiPlayerbot.RandomBotAutoJoinBGTPCount = 1
AiPlayerbot.RandomBotAutoJoinBGBFGCount = 1
AiPlayerbot.RandomBotAutoJoinBGTOKCount = 1
AiPlayerbot.RandomBotAutoJoinBGSMCount = 1
AiPlayerbot.RandomBotAutoJoinBGDGCount = 1

# Arena bracket (single bracket only):
# Custom code changes are required for lower-level arena brackets to function properly.
# 5.4.8: brackets are PvPDifficultyEntry::RangeIndex of the arena map - 14 = level 80-84 (AC's default),
# 16 = level 90 on a 90-cap realm.
AiPlayerbot.RandomBotAutoJoinArenaBracket = 14

# Arena battles count: rated matches bots keep going in that bracket. Requires RandomBotAutoJoinBG, and
# (as on AC) starts only once every random bot is logged in.
AiPlayerbot.RandomBotAutoJoinBGRatedArena2v2Count = 0
AiPlayerbot.RandomBotAutoJoinBGRatedArena3v3Count = 0
AiPlayerbot.RandomBotAutoJoinBGRatedArena5v5Count = 0

# Rated battleground matches bots keep going (#897, beyond AC - AC has no rated BG). Level-max random bots
# gather a same-faction 10-man raid (2 while `.debug ratedbg` testing is on) and queue the rated battleground;
# a real player waiting in that queue also gets bot opponents. 0 = off. Requires RandomBotAutoJoinBG.
AiPlayerbot.RandomBotAutoJoinBGRatedBGCount = 0

# Random bot arena team count / rating / delete: AC keys (AC conf.dist:2065-2077), NOT SUPPORTED on 5.4.8 -
# arena teams were removed in patch 5.4.0 (#437, #409); bots gather a party per match instead. Commented out
# (#304: no key may look configured and do nothing); listed so the key set still maps to AC's.
# AiPlayerbot.RandomBotArenaTeam2v2Count = 10
# AiPlayerbot.RandomBotArenaTeam3v3Count = 10
# AiPlayerbot.RandomBotArenaTeam5v5Count = 5
# AiPlayerbot.RandomBotArenaTeamMaxRating = 2000
# AiPlayerbot.RandomBotArenaTeamMinRating = 1000
# AiPlayerbot.DeleteRandomBotArenaTeams = 0

# PvP Restricted Zones (bots will not initiate PvP or defend themselves if attacked)
AiPlayerbot.PvpProhibitedZoneIds = "2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323,4395,3703,4298,3951"

# PvP Restricted Areas (bots will not initiate PvP or defend themselves if attacked)
AiPlayerbot.PvpProhibitedAreaIds = "976,35,392,2268,4161,4010,4317,4312,3649,3887,3958,3724,4080,3938,3754,3786,3973,4085,4086,4087,4088"

# Improve react speed in battleground and arena (may cause lag)
AiPlayerbot.FastReactInBG = 1

