####################################################################################################

####################################################################################################
# LOGS
#
#

# Custom config to allow logfiles to be created.
# Example: AiPlayerbot.AllowedLogFiles = travelNodes.csv,travelPaths.csv,TravelNodeStore.h,bot_movement.csv,bot_location.csv
AiPlayerbot.AllowedLogFiles = ""

#
#
#
####################################################################################################

###################################################################################################
###################################################################################################
###################################################################################################
###################################################################################################
###################################################################################################

##############################################
# Deprecated (temporary)                     #
##############################################

# Log on all random bots on start
AiPlayerbot.RandomBotLoginAtStartup = 1

# Guild Task system
AiPlayerbot.EnableGuildTasks = 0

# Enable dungeon suggestions in lower case randomly
AiPlayerbot.SuggestDungeonsInLowerCaseRandomly = 0

# Random bot guild count: random bots found guilds up to this many (the pass below). 0 = no bot guilds.
AiPlayerbot.RandomBotGuildCount = 20

# Bot guilds (beyond AC, replaces AC's guild strategy and its per-bot-tick actions): one world-thread pass every
# IntervalSeconds. Free random bots of level MinFoundLevel or more found a guild (FoundChance percent per pass, up to
# RandomBotGuildCount guilds, the founder pays the charter price and the name comes from playerbots_guild_names); a guild
# with fewer than MaxMembers members invites free random bots of its leader's faction within LevelWindow levels (at most
# InvitesPerPass invites per pass; AcceptChance percent of the invited accept, 15 to 90 s later). Every RefreshMinutes the
# leader kicks a bot member that has been offline for InactiveDays days, demotes an officer or veteran that has been away for
# half of it, and promotes the highest level online bot member now and then (PromoteChance percent, up to rank MaxPromoteRank,
# 2 = veteran); a member leaves its guild at LeavePercentPerDay percent a day; the leader welcomes, congratulates and
# says goodbye in guild chat (WelcomeChance percent). Humans and alt bots are never kicked, demoted or promoted.
# InviteHumans: a leader near a guildless player (HumanMinLevel or more, within HumanInviteRadius yards, same faction) whispers an
# offer and sends the ordinary guild invite the player can decline, at HumanInviteChance percent per pass, once per
# HumanInviteCooldownHours per player. Off by default. The guild task system is not ported (design decision 0016).
# Default: 1 / 60 / 5 / 15 / 25 / 10 / 10 / 3 / 80 / 60 / 14 / 25 / 2 / 5 / 0 / 5 / 24 / 60 / 8
AiPlayerbot.BotGuilds.Enable = 1
AiPlayerbot.BotGuilds.IntervalSeconds = 60
AiPlayerbot.BotGuilds.RefreshMinutes = 5
AiPlayerbot.BotGuilds.MaxMembers = 15
AiPlayerbot.BotGuilds.FoundChance = 25
AiPlayerbot.BotGuilds.MinFoundLevel = 10
AiPlayerbot.BotGuilds.LevelWindow = 10
AiPlayerbot.BotGuilds.InvitesPerPass = 3
AiPlayerbot.BotGuilds.AcceptChance = 80
AiPlayerbot.BotGuilds.WelcomeChance = 60
AiPlayerbot.BotGuilds.InactiveDays = 14
AiPlayerbot.BotGuilds.PromoteChance = 25
AiPlayerbot.BotGuilds.MaxPromoteRank = 2
AiPlayerbot.BotGuilds.LeavePercentPerDay = 5
AiPlayerbot.BotGuilds.InviteHumans = 0
AiPlayerbot.BotGuilds.HumanInviteChance = 5
AiPlayerbot.BotGuilds.HumanInviteCooldownHours = 24
AiPlayerbot.BotGuilds.HumanInviteRadius = 60
AiPlayerbot.BotGuilds.HumanMinLevel = 8

# Social life of the random bots (design decision 0033 points 14 to 16, docs/social/social.md). Both parts are off: while a switch
# is 0 nothing reads or writes its data and the bots behave as before.
#
# Liking: a score from 0 to 100 for every bot and human that shared a moment, kept in the playerbots database table
# playerbots_social_liking. Grouping, a finished dungeon, a trade, a duel, guild time and thanks raise it; rudeness, a kick
# and ninja looting lower it; with nothing happening it drifts back to Neutral. It will gate the bots' group offers and
# guild invites and go into the AI sidecar's prompts. Percent values below are points of the 0 to 100 scale.
# Default: 0 (off)
AiPlayerbot.Social.Liking.Enable = 0

# The score of a pair with no history, and where an old score drifts back to; days for the distance to halve.
AiPlayerbot.Social.Liking.Neutral = 30
AiPlayerbot.Social.Liking.DecayHalfLifeDays = 21

# The most one pair can gain in a day, so a long session or repeated trades cannot farm the score. Rude moves are not capped.
AiPlayerbot.Social.Liking.DailyGainCap = 15

# Minutes of grouping that make one step of the group-time gain.
AiPlayerbot.Social.Liking.GroupStepMinutes = 10

# Score change of one step of each event (hours for GuildHour), in points.
AiPlayerbot.Social.Liking.Delta.GroupStep = 1
AiPlayerbot.Social.Liking.Delta.DungeonDone = 6
AiPlayerbot.Social.Liking.Delta.Traded = 2
AiPlayerbot.Social.Liking.Delta.Dueled = 2
AiPlayerbot.Social.Liking.Delta.GuildHour = 1
AiPlayerbot.Social.Liking.Delta.Thanked = 2
AiPlayerbot.Social.Liking.Delta.Insulted = -10
AiPlayerbot.Social.Liking.Delta.Kicked = -8
AiPlayerbot.Social.Liking.Delta.LootNinja = -15

# Band edges: below ColdBelow the bot is cold to the human, from FriendlyAt a friend, from CloseAt a close one.
AiPlayerbot.Social.Liking.ColdBelow = 20
AiPlayerbot.Social.Liking.FriendlyAt = 55
AiPlayerbot.Social.Liking.CloseAt = 75

# Group-invite chance points per 100 points of score away from Neutral (60 makes a friend worth +15, like the FriendBonus).
AiPlayerbot.Social.Liking.InviteSpan = 60

# The lowest score at which a bot offers a human a group for a shared quest, or a guild, and how many such offers one human
# gets per hour from all bots together.
AiPlayerbot.Social.Liking.QuestOfferMin = 40
AiPlayerbot.Social.Liking.GuildOfferMin = 55
AiPlayerbot.Social.Liking.QuestOffersPerHour = 2
AiPlayerbot.Social.Liking.GuildOffersPerHour = 1

# A kick this many seconds after the bot joined the group counts for nothing (a mis-click, a bot invited by mistake).
AiPlayerbot.Social.Liking.KickGraceSeconds = 120

# Days a row is kept without a change; the cleanup drops it after that, once decay has taken it back to Neutral.
AiPlayerbot.Social.Liking.RetentionDays = 180

# Playstyle: each random bot gets a lasting style from its guid (quester, gatherer-crafter, trader, socializer, PvPer) that
# multiplies the AiPlayerbot.RpgStatusProbWeight.* weights its own way. A weight set to 0 stays 0.
# Default: 0 (off)
AiPlayerbot.Social.Playstyle.Enable = 0

# Relative size of each style among the bots (only the proportions count). All 0 makes every bot a quester.
AiPlayerbot.Social.Playstyle.Share.Quester = 40
AiPlayerbot.Social.Playstyle.Share.GathererCrafter = 15
AiPlayerbot.Social.Playstyle.Share.Trader = 10
AiPlayerbot.Social.Playstyle.Share.Socializer = 20
AiPlayerbot.Social.Playstyle.Share.PvPer = 15

# How much of the styles' lean is applied, in percent: 0 none, 100 the designed table, 200 twice as far.
AiPlayerbot.Social.Playstyle.Strength = 100

# Shared-quest group offers (design decision 0033 point 16): a random bot that has the same unfinished quest as a human nearby, in the
# same zone, and likes that human (AiPlayerbot.Social.Liking.QuestOfferMin) whispers an offer and sends the ordinary group
# invite, which the human may decline. At most AiPlayerbot.Social.Liking.QuestOffersPerHour offers per human per hour from
# all bots together, never to a human in a group, never from a bot in combat, an instance or a battleground. Needs
# AiPlayerbot.Social.Liking.Enable = 1 as well (without the score there is nobody to like).
# Default: 0 (off)
AiPlayerbot.Social.QuestOffer.Enable = 0

# Yards (same map and zone), seconds between two passes over the humans, hours before the same bot offers the same human
# again, and levels apart that still make a group.
AiPlayerbot.Social.QuestOffer.Radius = 60
AiPlayerbot.Social.QuestOffer.PassSeconds = 30
AiPlayerbot.Social.QuestOffer.PairCooldownHours = 6
AiPlayerbot.Social.QuestOffer.LevelTolerance = 5

# Emote replies (design decision 0033 point 17): a random bot that a human emotes at (the human targets it and /waves, /dances, ...)
# answers with a fitting gesture, from the reaction table of the emote action without its spoken lines. An emote with no target
# is answered only by a bot very close by and only now and then. A human gets at most one reply per PerHumanSeconds from all
# bots together; a bot that is busy, dead or in an instance or battleground stays out, and so does one that does not like the
# human (liking band cold, when the liking switch is on).
# Default: 0 (off)
AiPlayerbot.Social.EmoteReplies.Enable = 0

# Yards for an emote aimed at the bot, yards for an emote with no target, seconds between two replies to one human, and the
# percent of untargeted emotes that get a reply.
AiPlayerbot.Social.EmoteReplies.Radius = 20
AiPlayerbot.Social.EmoteReplies.UntargetedRadius = 8
AiPlayerbot.Social.EmoteReplies.PerHumanSeconds = 60
AiPlayerbot.Social.EmoteReplies.UntargetedChance = 35

# Trade chatter in capital cities. Off by default. Only random bots in Social.OnlyBots may speak,
# and only while a human is in their zone. A bot waits five minutes after login.
# BotMinutes is the minimum interval per bot; ChannelPerMinute is the rolling limit per faction.
# A zero ChannelPerMinute disables sends. Listings and recipes must be real and current.
AiPlayerbot.Social.TradeChatter.Enable = 0
AiPlayerbot.Social.TradeChatter.BotMinutes = 60
AiPlayerbot.Social.TradeChatter.ChannelPerMinute = 2

# Soak support for the social parts above (docs/social/social.md section 13). OnlyBots: a comma separated list of bot names;
# when it is not empty only those bots take part in anything social (liking events and the score they send to the sidecar,
# group offers, guild offers, emote replies, playstyle weights); every other bot behaves as with the switches off. Names are
# not case sensitive. Empty means no limit.
# SoakLog: 1 writes one line per social action at info level (liking change, emote reply, offer: "[SOCIAL] liking ...",
# "[SOCIAL] emote ...", "[SOCIAL] offer ..."; bots by name, humans by low guid only); 0 keeps them at debug level. Offers are always
# at info level.
# SummarySeconds: seconds between interval summaries (also written at shutdown); 0 turns periodic summaries off.
# Default: empty, 0, 1800
AiPlayerbot.Social.OnlyBots =
AiPlayerbot.Social.SoakLog = 0
AiPlayerbot.Social.SummarySeconds = 1800

# The bots' auction house (design decision 0033 and 0034, docs/economy/pricing-audit.md). Random bots list what they looted,
# gathered or crafted and buy what they need, from the auction house of their own faction, at prices from one range per
# item (the table playerbots_item_price in the world database, applied from data/sql/db-world by the core's updater).
# At most 25 percent of the gold above the repair reserve is spent per visit. 1 loads the price table at start; the
# listing, buying (buyouts only) and mail code runs in the auction errand and stays off until the unit tests and an overnight soak pass.
# Default: 0 (off)
AiPlayerbot.Auction.Enable = 0

# A listing runs 12 hours, and 24 hours when the stack's price is above this many gold (the deposit is charged for the
# duration chosen). 0 keeps every listing at 12 hours.
# Default: 5
AiPlayerbot.Auction.LongListingMinGold = 5

# Before the auction house may buy, a bot keeps its repair reserve plus a fund for the next trainer spells, the next riding
# skill and a mount (costs from the 5.4.8 trainer and vendor data, src/Utils/ReserveTable.h). This is how many levels ahead
# of its own the fund looks. Range 0 to 20.
# Default: 5
AiPlayerbot.Auction.ReserveLookaheadLevels = 5

# The fund is capped at this percent of the gold above the repair reserve, so a bot saving for a 5,000 gold riding skill
# still has some gold to trade with. 100 keeps the whole fund back (a bot holding less than the fund buys nothing). Deposits
# are held back by the repair reserve only, so a saving bot can still list what it sells to pay for the goal.
# Default: 75
AiPlayerbot.Auction.ReserveGoalSharePercent = 75

# A bot with a primary crafting profession (not gathering only) keeps this percent of the gold above its repair reserve
# for profession recipes, on top of the goal share above. The two never add up to more than 100 (the recipe share is cut to
# what the goal share leaves) and the recipe part never holds more than 700 gold. Deposits are not held back by it.
# Range 0 to 100. 0 keeps no gold for recipes.
# Default: 10
AiPlayerbot.Auction.ReserveRecipeSharePercent = 10

# Random crafters may buy usable vendor recipes during a vendor trip, using their recipe reserve.
# OnlyBots below also limits these purchases when it names bots. Daily counts reset at UTC midnight
# and persist across restarts. Zero for either limit prevents purchases. Default: 0, 1, 3.
AiPlayerbot.RecipeBuying.Enable = 0
AiPlayerbot.RecipeBuying.PerVisit = 1
AiPlayerbot.RecipeBuying.PerDay = 3

# Names of the characters that may use the auction house, separated by commas (names are not case sensitive). Empty lets every
# random bot of the module go. The soak names a handful of bots here first. A bot that is not a random bot never uses it.
# Default: empty
AiPlayerbot.Auction.OnlyBots = ""

# What one visit to the auctioneer may do: new listings, purchases (buyouts only, a bid is never placed), listings a bot may
# have on the house in all, and minutes between two visits of the same bot. The visit takes 2 to 5 seconds per operation.
# Default: 4, 3, 20, 60
AiPlayerbot.Auction.MaxListingsPerVisit = 4
AiPlayerbot.Auction.MaxPurchasesPerVisit = 3
AiPlayerbot.Auction.MaxActiveListings = 20
AiPlayerbot.Auction.VisitCooldownMinutes = 60

# 0 stops the purchases and leaves the selling and the mail (the soak's kill switch for buying).
# Default: 1
AiPlayerbot.Auction.Buy.Enable = 1

# Operations the auction visits may run in one world tick, over all bots.
# Default: 3
AiPlayerbot.Auction.SlicesPerTick = 3

# Minutes between "[AUCTION] summary" lines. Transactions are cumulative; tick, queue and snapshot measurements are per interval.
# 0 disables interval summaries; a shutdown summary is still written.
# Default: 30
AiPlayerbot.Auction.SummaryMinutes = 30

# Delete all random bot guilds
AiPlayerbot.DeleteRandomBotGuilds = 0

# Chance bot chooses RPG (Teleport to random camp for their level) instead of grinding
# In the "new rpg" strategy: chance a status change prefers an rpg camp destination over grinding
AiPlayerbot.RandomBotRpgChance = 0.20

# Set randombots movement speed to walking anywhere
AiPlayerbot.RandombotsWalkingRPG = 0

# Set randombots movement speed to walking only inside buildings
AiPlayerbot.RandombotsWalkingRPG.InDoors = 0

# Premade spell to avoid (undetected spells)
# spellid-radius, ...
AiPlayerbot.PremadeAvoidAoe = 62234-4

AiPlayerbot.MinRandomBotsPriceChangeInterval = 7200
AiPlayerbot.MaxRandomBotsPriceChangeInterval = 172800
AiPlayerbot.MinRandomBotChangeStrategyTime = 180
AiPlayerbot.MaxRandomBotChangeStrategyTime = 720


# How often tasks are changed
AiPlayerbot.MinGuildTaskChangeTime = 172800
AiPlayerbot.MaxGuildTaskChangeTime = 432000

# Mail spam interval
AiPlayerbot.MinGuildTaskAdvertisementTime = 300
AiPlayerbot.MaxGuildTaskAdvertisementTime = 28800

# Delay before reward is sent
AiPlayerbot.MinGuildTaskRewardTime = 300
AiPlayerbot.MaxGuildTaskRewardTime = 3600

# Cleanup of guild tasks interval
AiPlayerbot.GuildTaskAdvertCleanupTime = 300

# Specify max distance between victim and bot when creating guild kill task
AiPlayerbot.GuildTaskKillTaskDistance = 200

# Distance margin for facade calculations
AiPlayerbot.TargetPosRecalcDistance = 0.1

# Allow bots to be summoned near innkeepers
AiPlayerbot.SummonAtInnkeepersEnabled = 1


###################################################################################################
# AI LAYER (aware-ai sidecar, design decision 0014, 0026 and 0029)
#   Connects worldserver to the sidecar and watches its status and budget; the battleground leaders ask it for their
#   strategy (AwareAi.Pvp.*) and the rules play on when it does not answer. With
#   AwareAi.Chat.Enable bots ask it for their lines in player-to-player moments. Commands (.bot ai status, on, off,
#   budget) change the live values until the next restart; SkyFire does not reload this file, so edits need a restart.
###################################################################################################

# Master switch. 0 means the module never contacts the sidecar and bots behave exactly as without this block.
# The sidecar also decides on its own whether anything is answered: without an OPENROUTER_API_KEY it is off, and with
# AWARE_AI_FAKE set it answers with canned test replies instead of calling a model.
AwareAi.Enable = 0

# Base URL of the aware-ai sidecar on the Compose "ai" network (service name aware-ai, never published on the host).
AwareAi.SidecarUrl = "http://aware-ai:8090"

# Per-feature switch, only used while AwareAi.Enable is 1.
AwareAi.Pvp.Enable = 1

# How long a bot will wait for a decision before its own rules decide. Valid range 100-5000. The battleground leader's
# strategy asks use it as the sidecar's deadline; a late answer is dropped and the rules keep playing.
AwareAi.DecisionDeadlineMs = 600

# Battleground strategy (design decision 0032 point 9), only used while AwareAi.Enable and AwareAi.Pvp.Enable are 1. The leader
# bot of each side asks the sidecar which stance, floater job, wipe reply or target node the team should play, every
# BgIntervalSeconds (clamped to 15-30) and after a flag or node event (never more than once in 5 s), one request in flight
# per side and only when two materially different legal options exist. The rules play at once and keep playing when the
# answer is late, stale, below MinConfidence (0-1), from another leader or not offered. MaxRequestsPerMatchSide caps the
# asks of one side in one match (a request count, not a dollar budget; 0 stops the asks).
AwareAi.Pvp.BgIntervalSeconds = 20
AwareAi.Pvp.MinConfidence = 0.6
AwareAi.Pvp.MaxRequestsPerMatchSide = 60

# Spending caps in US dollars, pushed to the sidecar every 30 seconds. One monthly pool is shared by the PvP decisions
# and chat (design decision 0031, $20). The sidecar clamps it to its own ceiling (AWARE_AI_MONTHLY_CEILING_USD, 20 by
# default), so asking for more changes nothing. DailyUsd 0 (the default) means no daily cap, and the sidecar only raises
# an alarm on an unusual day's spend. Valid range 0-10000.
AwareAi.Budget.MonthlyUsd = 20
AwareAi.Budget.DailyUsd = 0

# Write link and budget changes and GM commands to <LogsDir>/ai/ai-events-YYYY-MM-DD.jsonl.
AwareAi.Events.Enable = 1

# Player-to-player chat (design decision 0029, phase 1), only used while AwareAi.Enable is 1. A bot asks the sidecar for its
# line when a human challenges it to a duel, wins or loses a duel against it, whispers it, talks near it (say), talks
# in its party or raid (or the group has a moment: a greeting, a wipe, a boss kill) and writes in its guild chat. Only
# humans are answered, never another bot. A trivial line ("hi", "ty", "gg", "lol", "np", "ok", "cya" and the like) is
# answered from the module's own template lines per personality, without asking the sidecar. Every failure (the
# sidecar down, a timeout, a cap or rate limit reached, an empty answer) falls back to the bot's own rule line for that
# moment, or to a short canned line of its personality ("gg", "lol", "busy rn", "sure", "nah"). A whisper or group
# line the module reads as a command ("follow", "attack", "inv" and the like) never gets a chat reply.
# Requests carry game context only: character names, class, race, level, zone, the human's line and the bot's voice.
# Each request writes one "chat" event to the events log (no chat text in Server.log). Also sets the sidecar's chat
# feature, which is off there unless this is 1. With chat on, the module also tells the sidecar's memory what a bot
# and a human shared (design decision 0031, fire and forget, bot and human pairs only): they grouped, finished a finder or
# party run, killed a boss or wiped together, a duel the bot won or lost, loot the human passed to the bot or needed
# on a lighter armor than their own while the bot needed it, and an obvious thanks or insult to the bot. With chat on,
# random bots also take the chat spec's personality mix (25 quiet, 50 friendly, 10 chatty, 15 rough); alt bots keep
# theirs. Read once at start-up.
# Default: 0 (off: bots behave exactly as without it)
AwareAi.Chat.Enable = 0

# Send the bot's liking score for the human (percent and a band word: cold, stranger, friendly, close) with chat requests, so the
# sidecar's prompt can use it (design decision 0033 point 14): the fields are `liking` (0 to 1) and `relation` (the band word). Turn it
# on only after the sidecar accepts the two fields (it ships them with its wipe endpoint): its request schema rejects unknown
# ones. Needs AiPlayerbot.Social.Liking.Enable = 1; a pair whose rows are not loaded yet sends neither field and the sidecar
# falls back to its own score. With the AI layer on, ".playerbots social wipe" also asks the sidecar to forget the human.
# Default: 0 (off)
AwareAi.Chat.SendLiking = 0

# Whether the bots deny being bots when a player asks. With 1 the chat request carries `deny_being_bot` and the sidecar's
# prompt tells the bot to deny it playfully; with 0 the field is left out and the bot may admit it (the sidecar's own
# default). Turn it on only after the sidecar accepts the field (its request schema rejects unknown ones).
# Default: 0 (the bots may admit they are bots)
AwareAi.Chat.DenyBeingBot = 0

# How long a bot waits for the sidecar's line before it uses its rule line. The reply itself still waits a reading
# and typing time scaled by the length of both lines (1 to 5 s), so nothing is said at once, and the 2.5 s default
# hides even a slow answer (the chat model's slowest tenth took about 1.4 s in testing). Valid range 500-5000.
AwareAi.Chat.DeadlineMs = 2500

# Reply timing for answers to a human's line (design decision 0031). LateChance: percent of answers that come 30 to 90 s late,
# like a player who was busy (not for guild lines, which go stale). While the bot is in combat: CombatSkipChance
# percent of answers are dropped and CombatWaitChance percent wait until the fight is over (at most 2 minutes); the
# rest are typed in the fight. A whisper is never dropped: it waits for the end of the fight and gets one late line,
# which also answers whatever else the human wrote meanwhile. Duel and group voice moments always come at once.
# Conversation mode (no switch): while a human's last line to a bot is under 2 minutes old, that bot answers their say
# and party lines as if named (the sidecar keeps it near 4 lines a minute), lines that arrive while it still reads
# merge into one request ("line one / line two"), and lines that arrive while it types get one more answer together.
# Valid range 0-100 each.
AwareAi.Chat.LateChance = 7
AwareAi.Chat.CombatWaitChance = 60
AwareAi.Chat.CombatSkipChance = 20

# Percent chance that one nearby bot answers a human's /say line, and that one bot of the group answers a human's
# party or raid line. NearbyChance is the base for a bot the line is not meant for, scaled by its personality (quiet
# half, rough 0.8, chatty 1.5); a bot the human targets or names answers 75 to 90 percent of the time (rough bots
# least, chatty most) and one standing within 5 yards of the human doubles its chance up to 90. A party or raid line
# that names the bot is always answered. Bot voice moments (greeting, wipe, boss kill) keep the chances of
# AiPlayerbot.Voice.*; when such a moment speaks, its words come from the sidecar. Valid range 0-100.
AwareAi.Chat.NearbyChance = 25
AwareAi.Chat.PartyChance = 30

# Openers (design decision 0031): small moments where a bot speaks first, through the sidecar with a canned line as the
# fallback. Enable turns them all on or off. A human gets at most one opener per CooldownSeconds (valid range
# 10-3600), whatever its kind. GreetChance: when a human joins a group with bots (not a Dungeon Finder group, whose
# bots greet on their own), one bot says hello. LevelChance: when a human levels up, one bot of the group nearby, or
# else one bot standing near, says gz. DuelAskChance: every DuelAskCheckSeconds (valid range 30-3600) an idle human
# out of instances may be asked for a duel by a rough or chatty bot standing near, of a level within 5 of theirs. A
# group mate's rare or epic roll win keeps the bot voice's own grats chance (AiPlayerbot.LootEtiquette.GratsChance);
# when a bot congratulates a human, the words come from the sidecar. Chances: valid range 0-100.
AwareAi.Chat.Opener.Enable = 1
AwareAi.Chat.Opener.CooldownSeconds = 120
AwareAi.Chat.Opener.GreetChance = 60
AwareAi.Chat.Opener.LevelChance = 50
AwareAi.Chat.Opener.DuelAskChance = 5
AwareAi.Chat.Opener.DuelAskCheckSeconds = 120

# Friendly whispers (design decision 0031): a bot that grouped or duelled with a human since the server started whispers them
# first, at most 1 to MaxPerSession times per play session (from the human's login; valid range 0-2), never while the
# human fights or is in a dungeon, raid or battleground, and only from a bot out of combat and out of their group.
# Every CheckSeconds (valid range 30-3600) the timer rolls Chance (valid range 0-100). The sidecar checks the bot's
# relation with the human and may refuse; a refusal or a failure says nothing (no canned line here).
AwareAi.Chat.FriendWhisper.Enable = 1
AwareAi.Chat.FriendWhisper.MaxPerSession = 2
AwareAi.Chat.FriendWhisper.CheckSeconds = 300
AwareAi.Chat.FriendWhisper.Chance = 15

# Guild chat: how long after a human's guild line the bots may still answer it (the sidecar refuses lines older than
# its own AWARE_AI_GUILD_RECENT_S, 60 by default; valid range 5-60), and how many online bots of that guild answer
# it (1 or 2).
AwareAi.Chat.Guild.WindowSeconds = 60
AwareAi.Chat.Guild.Bots = 1

# Battleground chat (design decision 0029, phase 2): when a battleground ends, one or two bots of each team that has a human
# player say a short line in their team's battleground chat (kinds bg_win and bg_loss; never in an arena, nothing for
# a draw). Flag captures in Warsong Gulch and Twin Peaks can also trigger bg_capture while the match runs.
# Speakers (valid range 1-2) is the most bots per team; with 2, the second one speaks in half of the matches,
# a few seconds after the first. The talkative personalities speak more often. A speaker stays in the ended match
# until it said its line (at most 20 s), then leaves as before. With the sidecar down a short canned line of the
# bot's personality is said ("gg wp", "ez", "gg, close one").
AwareAi.Chat.Battleground.Enable = 1
AwareAi.Chat.Battleground.Speakers = 2
###############################################################################
# Arena ladder (BT-154, design decision 0027): named teams of random bots (the pilot: 2v2), a team rating of their own, a light
# schedule of bot-versus-bot matches, a ladder NPC, bot chat about the results and a JSON snapshot for a status page.
# The 5.4.8 core keeps no arena rating, so the module's books are the only ladder. Needs the three tables
# playerbots_arena_team, playerbots_arena_team_member and playerbots_arena_match (created at start-up when missing).
###############################################################################

# Turns the whole feature on or off (a restart applies it). Off: no teams, no matches, no ladder NPC pages; the arena
# bots behave as before.
# Default: 1 (enabled)
AiPlayerbot.ArenaTeams.Enable = 1

# The ladder NPC "Pit Chronicler" (needs Enable = 1): the module spawns it beside the arena battlemasters of the capitals and
# the Pandaria shrines whenever their grid loads, as a creature that is never saved to the database. Its template, menu and
# texts come from data/sql/db-world/2026_11_12_00_arena_ladder_npc.sql, which must be applied to the world database (the module logs once at
# start-up when it is missing and spawns nothing). 0 turns the spawns off only; the ladder itself keeps running. A restart
# applies a change; NPCs already standing leave with their grid.
# Default: 1 (enabled)
AiPlayerbot.ArenaTeams.LadderNpc = 1

# Teams form only from this level (before it the bots play PvE, dungeons and battlegrounds). A team belongs to the 5-level
# band of its members (60 to 64, 65 to 69 ...) and moves up with them.
# Default: 60
AiPlayerbot.ArenaTeams.MinLevel = 60

# How many active teams each faction keeps per level band, and the lowest pair score (class and spec composition: healer,
# crowd control, interrupts, burst) a new team needs.
# Default: 4 / 60
AiPlayerbot.ArenaTeams.PerFaction = 4
AiPlayerbot.ArenaTeams.MinPairScore = 60

# The target mix of skill tiers among the teams of a faction and band (expert, good, casual). A team plays at the tier of
# its weakest member.
# Default: 1 / 3 / 2
AiPlayerbot.ArenaTeams.MixExpert = 1
AiPlayerbot.ArenaTeams.MixGood = 3
AiPlayerbot.ArenaTeams.MixCasual = 2

# Seconds after the start before the first team formation run, and between the runs (each run also checks the teams: levels,
# specialisations, deleted characters). Short values are for testing.
# Default: 600 / 600
AiPlayerbot.ArenaTeams.StartupDelaySeconds = 600
AiPlayerbot.ArenaTeams.FormationIntervalSeconds = 600

# Bot-versus-bot matches: at most this many an hour at full activity, one at a time, none while the world update time
# (the diff between two ticks, averaged over about five seconds) is above MaxUpdateMs. The activity follows the clock below: quiet from 23:00 to 11:00 every day, then 25 percent on
# weekdays (60 percent at the weekend) until 17:00, 60 (80) until 19:00 and full activity until 23:00.
# Default: 4 / 1 / 80
AiPlayerbot.ArenaTeams.PeakMatchesPerHour = 4
AiPlayerbot.ArenaTeams.MaxConcurrentBotMatches = 1
AiPlayerbot.ArenaTeams.MaxUpdateMs = 80

# A bot-only match that nobody has won after this many minutes ends as a draw (0: never). A match with a human is never cut.
# Default: 12
AiPlayerbot.ArenaTeams.BotMatchCutMinutes = 12

# The clock the activity above follows, meant to be the server's local clock: the offset from UTC in standard time, whether
# the US daylight saving rule applies (second Sunday of March to first Sunday of November), and a test hook that moves the
# clock by minutes (480 turns 19:00 into 03:00). With 0 / 0 the activity follows UTC.
# Default: 0 / 0 / 0
AiPlayerbot.ArenaTeams.OwnerUtcOffsetHours = 0
AiPlayerbot.ArenaTeams.OwnerUsDst = 0
AiPlayerbot.ArenaTeams.ClockOffsetMinutes = 0

# A team whose members stay out of step or under the minimum level for this many checks in a row is retired (its name stays
# reserved). A team that lost a member (deleted character) may find a new partner once every ReplacePartnerDays days.
# Default: 12 / 7
AiPlayerbot.ArenaTeams.RetireAfterChecks = 12
AiPlayerbot.ArenaTeams.ReplacePartnerDays = 7

# A queued pair that has not entered an arena after this many seconds is released; a finished match frees its teams when
# the bots have left, at the latest after ReleaseAfterSeconds.
# Default: 240 / 300
AiPlayerbot.ArenaTeams.QueueTimeoutSeconds = 240
AiPlayerbot.ArenaTeams.ReleaseAfterSeconds = 300

# The JSON snapshot for a status page: the file name inside the world server's LogsDir, written at most every SnapshotMinSeconds
# after a change and at least every SnapshotMaxSeconds.
# Default: arena-ladder.json / 30 / 300
AiPlayerbot.ArenaTeams.SnapshotFile = "arena-ladder.json"
AiPlayerbot.ArenaTeams.SnapshotMinSeconds = 30
AiPlayerbot.ArenaTeams.SnapshotMaxSeconds = 300

# Ladder news in the General channel (a new team, win streaks, a climb, a broken streak, a close rivalry): one line for the
# whole ladder per LadderGapMinutes, per team one per TeamGapMinutes, at most PerDay in 24 hours, none in the quiet
# hours. The bot's personality decides whether a bot mentions it at all.
# Default: 1 / 15 / 45 / 12
AiPlayerbot.ArenaChat.Enable = 1
AiPlayerbot.ArenaChat.LadderGapMinutes = 15
AiPlayerbot.ArenaChat.TeamGapMinutes = 45
AiPlayerbot.ArenaChat.PerDay = 12

# Bank errands: random bots may store retained materials and other protected valuables at a banker.
# OnlyBots uses AiPlayerbot.Auction.OnlyBots. MaxMoves is clamped to 0 through 50.
AiPlayerbot.BankErrands.Enable = 0
AiPlayerbot.BankErrands.MaxMoves = 8
