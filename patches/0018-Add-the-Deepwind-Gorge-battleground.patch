+/************************************************************************/
+/*                     STARTING BATTLEGROUND                            */
+/************************************************************************/
+BattlegroundDG::BattlegroundDG()
+{
+    m_isInformedNearVictory = false;
+    // Each buff spot has one object, the buff type is not swapped when it is taken
+    m_BuffChange = false;
+
+    BgObjects.resize(BG_DG_OBJECT_MAX);
+    BgCreatures.resize(BG_DG_CREATURES_MAX);
+
+    StartMessageIds[BG_STARTING_EVENT_FIRST]    = LANG_BG_DG_START_TWO_MINUTES;
+    StartMessageIds[BG_STARTING_EVENT_SECOND]   = LANG_BG_DG_START_ONE_MINUTE;
+    StartMessageIds[BG_STARTING_EVENT_THIRD]    = LANG_BG_DG_START_HALF_MINUTE;
+    StartMessageIds[BG_STARTING_EVENT_FOURTH]   = LANG_BG_DG_HAS_BEGUN;
+}
+
+BattlegroundDG::~BattlegroundDG() { }
+
+bool BattlegroundDG::SetupBattleground()
+{
+    for (uint8 i = 0; i < BG_DG_ALL_NODES_COUNT; ++i)
+    {
+        if (!AddCreature(BG_DG_OBJECTID_CAPT_POINT, BG_DG_OBJECT_CAPT_POINT_START + i, 0, BG_DG_NodePositions[i][0], BG_DG_NodePositions[i][1], BG_DG_NodePositions[i][2], BG_DG_NodePositions[i][3], RESPAWN_IMMEDIATELY))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundDG: Failed to spawn the capture point %u. Battleground not created!", uint32(i));
+            return false;
+        }
+
+        float const sinHalfAngle = std::sin(BG_DG_AuraPositions[i][3] / 2);
+        float const cosHalfAngle = std::cos(BG_DG_AuraPositions[i][3] / 2);
+        for (uint8 j = 0; j < 3; ++j)
+        {
+            if (!AddObject(BG_DG_OBJECT_AURA_ALLY + j + BG_DG_OBJECT_DYNAMIC_TOTAL * i, BG_DG_AuraEntries[j], BG_DG_AuraPositions[i][0], BG_DG_AuraPositions[i][1], BG_DG_AuraPositions[i][2], BG_DG_AuraPositions[i][3], 0, 0, sinHalfAngle, cosHalfAngle, RESPAWN_ONE_DAY))
+            {
+                SF_LOG_ERROR("bg.battleground", "BattlegroundDG: Failed to spawn the banner aura %u of the node %u. Battleground not created!", uint32(j), uint32(i));
+                return false;
+            }
+        }
+
+        if (!AddObject(BG_DG_OBJECT_PJ_COLLISION + BG_DG_OBJECT_DYNAMIC_TOTAL * i, BG_DG_OBJECTID_PJ_COLLISION, BG_DG_CollisionPJPositions[i][0], BG_DG_CollisionPJPositions[i][1], BG_DG_CollisionPJPositions[i][2], BG_DG_CollisionPJPositions[i][3], 0, 0, 0, 0, RESPAWN_ONE_DAY))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundDG: Failed to spawn the collision object of the node %u. Battleground not created!", uint32(i));
+            return false;
+        }
+    }
+
+    for (uint8 team = TEAM_ALLIANCE; team <= TEAM_HORDE; ++team)
+    {
+        float const sinHalfAngle = std::sin(BG_DG_CartPositions[team][3] / 2);
+        float const cosHalfAngle = std::cos(BG_DG_CartPositions[team][3] / 2);
+        if (!AddObject(BG_DG_OBJECT_CART_ALLIANCE + team, BG_DG_CartEntries[team], BG_DG_CartPositions[team][0], BG_DG_CartPositions[team][1], BG_DG_CartPositions[team][2], BG_DG_CartPositions[team][3], 0, 0, sinHalfAngle, cosHalfAngle, RESPAWN_IMMEDIATELY))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundDG: Failed to spawn the cart of the team %u. Battleground not created!", uint32(team));
+            return false;
+        }
+    }
+
+    for (uint8 i = 0; i < 4; ++i)
+    {
+        if (!AddObject(BG_DG_OBJECT_GATE_1 + i, BG_DG_OBJECTID_GATE, BG_DG_DoorPositions[i][0], BG_DG_DoorPositions[i][1], BG_DG_DoorPositions[i][2], BG_DG_DoorPositions[i][3], BG_DG_DoorPositions[i][4], BG_DG_DoorPositions[i][5], BG_DG_DoorPositions[i][6], BG_DG_DoorPositions[i][7], RESPAWN_IMMEDIATELY))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundDG: Failed to spawn the gate %u. Battleground not created!", uint32(i));
+            return false;
+        }
+    }
+
+    for (uint8 i = 0; i < MAX_BUFFS_DG; ++i)
+    {
+        float const sinHalfAngle = std::sin(BG_DG_BuffPositions[i][3] / 2);
+        float const cosHalfAngle = std::cos(BG_DG_BuffPositions[i][3] / 2);
+        if (!AddObject(BG_DG_OBJECT_BUFF_NORTH + i, Buff_Entries[urand(0, 2)], BG_DG_BuffPositions[i][0], BG_DG_BuffPositions[i][1], BG_DG_BuffPositions[i][2], BG_DG_BuffPositions[i][3], 0, 0, sinHalfAngle, cosHalfAngle, BUFF_RESPAWN_TIME))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundDG: Failed to spawn the buff %u. Battleground not created!", uint32(i));
+            return false;
+        }
+    }
+
+    // The spirit guides stand at the graveyards of the team bases
+    for (uint8 team = TEAM_ALLIANCE; team <= TEAM_HORDE; ++team)
+    {
+        uint32 const teamId = team == TEAM_ALLIANCE ? ALLIANCE : HORDE;
+        float startX, startY, startZ, startO;
+        GetTeamStartLoc(teamId, startX, startY, startZ, startO);
+
+        for (uint8 graveyard = BG_DG_GRAVEYARD_NORTHERN; graveyard < BG_DG_MAX_GRAVEYARD; ++graveyard)
+        {
+            WorldSafeLocsEntry const* safeLoc = sWorldSafeLocsStore.LookupEntry(BG_DG_GraveyardIds[team][graveyard]);
+            if (!safeLoc || !AddSpiritGuide(BG_DG_SPIRIT_NORTHERN_ALLIANCE + team + graveyard * 2, safeLoc->x, safeLoc->y, safeLoc->z, startO, teamId))
+            {
+                SF_LOG_ERROR("bg.battleground", "BattlegroundDG: Failed to spawn the spirit guide %u of the team %u. Battleground not created!", uint32(graveyard), uint32(team));
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+void BattlegroundDG::Reset()
+{
+    Battleground::Reset();
+
+    bool isBGWeekEnd = sBattlegroundMgr->IsBGWeekend(GetTypeID());
+    m_honorTicks = isBGWeekEnd ? BG_DG_BBGWeekendHonorTicks : BG_DG_NotBGWeekendHonorTicks;
+    m_HonorWinKills = isBGWeekEnd ? 3 : 1;
+    m_HonorEndKills = isBGWeekEnd ? 4 : 2;
+    m_isInformedNearVictory = false;
+
+    for (uint8 team = TEAM_ALLIANCE; team <= TEAM_HORDE; ++team)
+    {
+        m_TeamScores[team] = 0;
+        m_lastTick[team] = 0;
+        m_honorScoreTics[team] = 0;
+        m_flagKeepers[team] = 0;
+        m_flagState[team] = BG_DG_CART_STATE_ON_BASE;
+        m_flagGold[team] = 0;
+        m_flagsDropTimer[team] = 0;
+    }
+
+    for (uint8 i = 0; i < BG_DG_ALL_NODES_COUNT; ++i)
+    {
+        m_nodes[i] = BG_DG_NODE_TYPE_NEUTRAL;
+        m_prevNodes[i] = BG_DG_NODE_TYPE_NEUTRAL;
+        m_nodeTimers[i] = 0;
+    }
+}
+
+void BattlegroundDG::EndBattleground(uint32 winner)
+{
+    // Win reward
+    if (winner == ALLIANCE || winner == HORDE)
+        RewardHonorToTeam(GetBonusHonorFromKill(m_HonorWinKills), winner);
+
+    // Complete map_end rewards (even if no team wins)
+    RewardHonorToTeam(GetBonusHonorFromKill(m_HonorEndKills), ALLIANCE);
+    RewardHonorToTeam(GetBonusHonorFromKill(m_HonorEndKills), HORDE);
+
+    Battleground::EndBattleground(winner);
+}
+
+void BattlegroundDG::StartingEventCloseDoors()
+{
+    // Despawn everything
+    for (uint8 i = BG_DG_OBJECT_AURA_ALLY; i < BG_DG_OBJECT_MAX; ++i)
+        SpawnBGObject(i, RESPAWN_ONE_DAY);
+
+    for (uint8 i = 0; i < BG_DG_ALL_NODES_COUNT; ++i)
+    {
+        SpawnBGObject(i * BG_DG_OBJECT_DYNAMIC_TOTAL + BG_DG_OBJECT_PJ_COLLISION, RESPAWN_IMMEDIATELY);
+        // The neutral aura is the contested one
+        SpawnBGObject(i * BG_DG_OBJECT_DYNAMIC_TOTAL + BG_DG_OBJECT_AURA_CONTESTED, RESPAWN_IMMEDIATELY);
+
+        if (Creature* capturePoint = GetBgMap()->GetCreature(BgCreatures[BG_DG_OBJECT_CAPT_POINT_START + i]))
+            capturePoint->CastSpell(capturePoint, BG_DG_CAPT_POINT_NEUTRAL, true);
+    }
+
+    for (uint8 i = BG_DG_OBJECT_CART_ALLIANCE; i <= BG_DG_OBJECT_CART_HORDE; ++i)
+        SpawnBGObject(i, RESPAWN_IMMEDIATELY);
+
+    for (uint8 i = 0; i < MAX_BUFFS_DG; ++i)
+        SpawnBGObject(BG_DG_OBJECT_BUFF_NORTH + i, RESPAWN_IMMEDIATELY);
+
+    for (uint8 i = BG_DG_OBJECT_GATE_1; i <= BG_DG_OBJECT_GATE_4; ++i)
+    {
+        DoorClose(i);
+        SpawnBGObject(i, RESPAWN_IMMEDIATELY);
+    }
+}
+
+void BattlegroundDG::StartingEventOpenDoors()
+{
+    for (uint8 i = BG_DG_OBJECT_GATE_1; i <= BG_DG_OBJECT_GATE_4; ++i)
+        DoorOpen(i);
+
+    // The capture points are clickable from now on
+    for (uint8 i = 0; i < BG_DG_ALL_NODES_COUNT; ++i)
+        if (Creature* capturePoint = GetBgMap()->GetCreature(BgCreatures[BG_DG_OBJECT_CAPT_POINT_START + i]))
+            for (BattlegroundPlayerMap::const_iterator itr = m_Players.begin(); itr != m_Players.end(); ++itr)
+                if (Player* player = ObjectAccessor::FindPlayer(itr->first))
+                    capturePoint->SendUpdateToPlayer(player);
+}
