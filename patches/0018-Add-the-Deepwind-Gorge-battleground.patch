diff --git a/src/server/scripts/Pandaria/Battlegrounds/deepwind_gorge.cpp b/src/server/scripts/Pandaria/Battlegrounds/deepwind_gorge.cpp
new file mode 100644
index 0000000000..925278e17f
--- /dev/null
+++ b/src/server/scripts/Pandaria/Battlegrounds/deepwind_gorge.cpp
@@ -0,0 +1,93 @@
+/*
+* This file is part of the Legends of Azeroth Pandaria Project. See THANKS file for Copyright information
