+uint32 const BG_DG_CartEntries[BG_TEAMS_COUNT]          = { BG_DG_OBJECTID_CART_ALLY, BG_DG_OBJECTID_CART_HORDE };
+uint32 const BG_DG_CartGroundEntries[BG_TEAMS_COUNT]    = { BG_DG_OBJECTID_CART_ALLY_GROUND, BG_DG_OBJECTID_CART_HORDE_GROUND };
+uint32 const BG_DG_CartSpells[BG_TEAMS_COUNT]           = { BG_DG_ALLIANCE_MINE_CART, BG_DG_HORDE_MINE_CART };
