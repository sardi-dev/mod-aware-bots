+void BattlegroundDG::HandleKillPlayer(Player* player, Player* killer)
+{
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    EventPlayerDroppedFlag(player);
+
+    Battleground::HandleKillPlayer(player, killer);
+}
+
+WorldSafeLocsEntry const* BattlegroundDG::GetClosestGraveYard(Player* player)
+{
+    uint8 teamIndex = GetTeamIndexByTeamId(player->GetBGTeam());
+
+    WorldSafeLocsEntry const* north = sWorldSafeLocsStore.LookupEntry(BG_DG_GraveyardIds[teamIndex][BG_DG_GRAVEYARD_NORTHERN]);
+    WorldSafeLocsEntry const* south = sWorldSafeLocsStore.LookupEntry(BG_DG_GraveyardIds[teamIndex][BG_DG_GRAVEYARD_SOUTHERN]);
+    if (!north || !south)
+        return north ? north : south;
+
+    // If you are on the southern side of the map, respawn at northern (and vice versa)
+    return player->GetExactDist2dSq(north->x, north->y) < player->GetExactDist2dSq(south->x, south->y) ? south : north;
+}
+
+void BattlegroundDG::UpdateTeamScore(uint8 team, int32 value)
+{
+    m_TeamScores[team] = std::max(0, std::min(m_TeamScores[team] + value, int32(BG_DG_MAX_VICTORY_POINTS)));
+
+    UpdateWorldState(team == TEAM_ALLIANCE ? WORLDSTATE_DG_SCORE_ALLIANCE : WORLDSTATE_DG_SCORE_HORDE, m_TeamScores[team]);
+
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    if (m_TeamScores[team] == BG_DG_MAX_VICTORY_POINTS)
+    {
+        UpdateWorldState(WORLDSTATE_DG_CART_STATE_ALLIANCE, BG_DG_CART_STATE_ON_BASE);
+        UpdateWorldState(WORLDSTATE_DG_CART_STATE_HORDE, BG_DG_CART_STATE_ON_BASE);
+        EndBattleground(team == TEAM_ALLIANCE ? ALLIANCE : HORDE);
+    }
+    else if (!m_isInformedNearVictory && m_TeamScores[team] > BG_DG_NEAR_VICTORY_POINTS)
+    {
+        SendMessageToAll(team == TEAM_ALLIANCE ? LANG_BG_DG_A_NEAR_VICTORY : LANG_BG_DG_H_NEAR_VICTORY, ChatMsg::CHAT_MSG_BG_SYSTEM_NEUTRAL);
+        PlaySoundToAll(team == TEAM_ALLIANCE ? BG_DG_SOUND_ALLIANCE_NEAR_VICTORY : BG_DG_SOUND_HORDE_NEAR_VICTORY);
+        m_isInformedNearVictory = true;
+    }
+}
