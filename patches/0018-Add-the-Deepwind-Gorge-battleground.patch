+void BattlegroundDG::UpdateCartState(uint8 carrierTeam, uint32 value)
+{
+    UpdateWorldState(carrierTeam == TEAM_ALLIANCE ? WORLDSTATE_DG_CART_STATE_ALLIANCE : WORLDSTATE_DG_CART_STATE_HORDE, value);
+}
+
+// The player carries the cart of the other team, which loses up to 200 points that the carrier gets when the cart is captured
+void BattlegroundDG::PickUpCart(Player* player, uint8 cartTeam)
+{
+    uint8 carrierTeam = cartTeam == TEAM_ALLIANCE ? TEAM_HORDE : TEAM_ALLIANCE;
+
+    PlaySoundToAll(BG_DG_CartPickedUpSounds[cartTeam]);
+    m_flagKeepers[cartTeam] = player->GetGUID();
+    m_flagState[cartTeam] = BG_DG_CART_STATE_ON_PLAYER;
+    UpdateCartState(carrierTeam, BG_DG_CART_STATE_ON_PLAYER);
+    player->CastSpell(player, BG_DG_CartSpells[cartTeam], true);
+    player->CastSpell(player, BG_DG_CartHolderAuras[cartTeam], true);
+    m_flagGold[cartTeam] = std::min(m_TeamScores[cartTeam], int32(BG_DG_CART_GOLD));
+    UpdateTeamScore(cartTeam, -m_flagGold[cartTeam]);
+
+    SendMessageForTeam(cartTeam == TEAM_ALLIANCE ? LANG_BG_DG_TAKEN_ALLIANCE_CART : LANG_BG_DG_TAKEN_HORDE_CART, carrierTeam, player);
+    player->RemoveAurasWithInterruptFlags(AURA_INTERRUPT_FLAG_ENTER_PVP_COMBAT);
+}
+
+void BattlegroundDG::ReturnCart(Player* player, uint8 cartTeam)
+{
+    uint8 carrierTeam = cartTeam == TEAM_ALLIANCE ? TEAM_HORDE : TEAM_ALLIANCE;
+
+    m_flagState[cartTeam] = BG_DG_CART_STATE_ON_BASE;
+    UpdateCartState(carrierTeam, BG_DG_CART_STATE_ON_BASE);
+    SpawnBGObject(BG_DG_OBJECT_CART_ALLIANCE + cartTeam, RESPAWN_IMMEDIATELY);
+    PlaySoundToAll(BG_DG_SOUND_CART_RETURNED);
+    UpdatePlayerScore(player, SCORE_CART_RETURNS, 1);
+
+    SendMessageForTeam(cartTeam == TEAM_ALLIANCE ? LANG_BG_DG_RETURNED_ALLIANCE_CART : LANG_BG_DG_RETURNED_HORDE_CART, cartTeam, player);
+    player->RemoveAurasWithInterruptFlags(AURA_INTERRUPT_FLAG_ENTER_PVP_COMBAT);
+}
+
+void BattlegroundDG::SendMessageForTeam(int32 entry, uint8 team, Player const* source)
+{
+    SendMessageToAll(entry, TeamChatMsg(team), source);
+}
+
+// A cart is picked up where it stands at its base, or from the ground where it was dropped (the object is removed by its use)
+void BattlegroundDG::EventPlayerClickedOnFlag(Player* player, GameObject* gameObject)
+{
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    uint8 playerTeam = GetTeamIndexByTeamId(player->GetBGTeam());
+    uint8 enemyTeam = playerTeam == TEAM_ALLIANCE ? TEAM_HORDE : TEAM_ALLIANCE;
+
+    // The enemy cart at its base
+    if (m_flagState[enemyTeam] == BG_DG_CART_STATE_ON_BASE && BgObjects[BG_DG_OBJECT_CART_ALLIANCE + enemyTeam] == gameObject->GetGUID())
+    {
+        SpawnBGObject(BG_DG_OBJECT_CART_ALLIANCE + enemyTeam, RESPAWN_ONE_DAY);
+        PickUpCart(player, enemyTeam);
+        return;
+    }
+
+    // A cart on the ground, the team it belongs to returns it and the other team takes it
+    for (uint8 cartTeam = TEAM_ALLIANCE; cartTeam <= TEAM_HORDE; ++cartTeam)
+    {
+        if (m_flagState[cartTeam] != BG_DG_CART_STATE_ON_GROUND || gameObject->GetEntry() != BG_DG_CartGroundEntries[cartTeam])
+            continue;
+
+        if (!player->IsWithinDistInMap(gameObject, 10.0f))
+            continue;
+
+        if (cartTeam == playerTeam)
+            ReturnCart(player, cartTeam);
+        else
+            PickUpCart(player, cartTeam);
+
+        return;
+    }
+}
+
+void BattlegroundDG::HandleAreaTrigger(Player* player, uint32 trigger)
+{
+    // A cart is captured at the spot of the own cart
+    switch (trigger)
+    {
+        case AREA_TRIGGER_ALLIANCE_CART_SPAWN:
+            if (player->GetBGTeam() == ALLIANCE)
+                EventPlayerCapturedFlag(player);
+            break;
+        case AREA_TRIGGER_HORDE_CART_SPAWN:
+            if (player->GetBGTeam() == HORDE)
+                EventPlayerCapturedFlag(player);
+            break;
+        default:
+            Battleground::HandleAreaTrigger(player, trigger);
+            break;
+    }
+}
+
+void BattlegroundDG::PostUpdateImplCart(uint32 diff)
+{
+    for (uint8 cartTeam = TEAM_ALLIANCE; cartTeam <= TEAM_HORDE; ++cartTeam)
+    {
+        if (m_flagState[cartTeam] != BG_DG_CART_STATE_ON_GROUND)
+            continue;
+
+        m_flagsDropTimer[cartTeam] -= diff;
+        if (m_flagsDropTimer[cartTeam] <= 0)
+        {
+            m_flagsDropTimer[cartTeam] = 0;
+            RespawnCartAfterDrop(cartTeam);
+        }
+    }
+}
+
+void BattlegroundDG::RespawnCartAfterDrop(uint8 cartTeam)
+{
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    m_flagState[cartTeam] = BG_DG_CART_STATE_ON_BASE;
+    UpdateCartState(cartTeam == TEAM_ALLIANCE ? TEAM_HORDE : TEAM_ALLIANCE, BG_DG_CART_STATE_ON_BASE);
+    SpawnBGObject(BG_DG_OBJECT_CART_ALLIANCE + cartTeam, RESPAWN_IMMEDIATELY);
+
+    if (GameObject* ground = GetBGObject(BG_DG_OBJECT_CART_ALLY_GROUND + cartTeam))
+        ground->Delete();
+}
+
+void BattlegroundDG::EventPlayerCapturedFlag(Player* player)
+{
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    uint8 playerTeam = GetTeamIndexByTeamId(player->GetBGTeam());
+    uint8 cartTeam = playerTeam == TEAM_ALLIANCE ? TEAM_HORDE : TEAM_ALLIANCE;
+    if (m_flagKeepers[cartTeam] != player->GetGUID())
+        return;
+
+    player->RemoveAurasWithInterruptFlags(AURA_INTERRUPT_FLAG_ENTER_PVP_COMBAT);
+
+    // Must be cleared before the auras go to prevent a drop together with the capture
+    m_flagKeepers[cartTeam] = 0;
+    player->RemoveAurasDueToSpell(BG_DG_CartSpells[cartTeam]);
+    player->RemoveAurasDueToSpell(BG_DG_CartHolderAuras[cartTeam]);
+
+    m_flagState[cartTeam] = BG_DG_CART_STATE_ON_BASE;
+    SpawnBGObject(BG_DG_OBJECT_CART_ALLIANCE + cartTeam, RESPAWN_IMMEDIATELY);
+    UpdateCartState(playerTeam, BG_DG_CART_STATE_ON_BASE);
+
+    int32 gold = m_flagGold[cartTeam];
+    m_flagGold[cartTeam] = 0;
+
+    PlaySoundToAll(BG_DG_CartCapturedSounds[playerTeam]);
+    SendMessageForTeam(cartTeam == TEAM_ALLIANCE ? LANG_BG_DG_CAPTURED_ALLIANCE_CART : LANG_BG_DG_CAPTURED_HORDE_CART, playerTeam, player);
+    UpdatePlayerScore(player, SCORE_CART_CAPTURES, 1);
+
+    // A captured cart is worth two honorable kills
+    RewardHonorToTeam(GetBonusHonorFromKill(2), player->GetBGTeam());
+
+    // Last, the gold can end the battleground
+    UpdateTeamScore(playerTeam, gold);
+}
+
+void BattlegroundDG::EventPlayerDroppedFlag(Player* player)
+{
+    uint8 cartTeam = GetTeamIndexByTeamId(player->GetBGTeam()) == TEAM_ALLIANCE ? TEAM_HORDE : TEAM_ALLIANCE;
+    if (m_flagKeepers[cartTeam] != player->GetGUID())
+        return;
+
+    m_flagKeepers[cartTeam] = 0;
+    player->RemoveAurasDueToSpell(BG_DG_CartSpells[cartTeam]);
+    player->RemoveAurasDueToSpell(BG_DG_CartHolderAuras[cartTeam]);
+
+    // Not running: nothing is dropped, only the auras are taken off
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    m_flagState[cartTeam] = BG_DG_CART_STATE_ON_GROUND;
+    m_flagsDropTimer[cartTeam] = BG_DG_CART_DROP_TIME;
+
+    // The gold goes back to the team the cart belongs to
+    UpdateTeamScore(cartTeam, m_flagGold[cartTeam]);
+    m_flagGold[cartTeam] = 0;
+
+    float const sinHalfAngle = std::sin(player->GetOrientation() / 2);
+    float const cosHalfAngle = std::cos(player->GetOrientation() / 2);
+    if (AddObject(BG_DG_OBJECT_CART_ALLY_GROUND + cartTeam, BG_DG_CartGroundEntries[cartTeam], player->GetPositionX(), player->GetPositionY(), player->GetPositionZ(), player->GetOrientation(), 0, 0, sinHalfAngle, cosHalfAngle))
+        SpawnBGObject(BG_DG_OBJECT_CART_ALLY_GROUND + cartTeam, RESPAWN_IMMEDIATELY);
+
+    player->CastSpell(player, SPELL_RECENTLY_DROPPED_FLAG, true);
+    UpdateCartState(GetTeamIndexByTeamId(player->GetBGTeam()), BG_DG_CART_STATE_ON_BASE);
+    SendMessageForTeam(cartTeam == TEAM_ALLIANCE ? LANG_BG_DG_DROPPED_ALLIANCE_CART : LANG_BG_DG_DROPPED_HORDE_CART, GetTeamIndexByTeamId(player->GetBGTeam()), player);
+}
+
+/************************************************************************/
+/*                        ENDING BATTLEGROUND                           */
+/************************************************************************/
+void BattlegroundDG::RemovePlayer(Player* player, uint64 guid, uint32 /*team*/)
+{
+    for (uint8 cartTeam = TEAM_ALLIANCE; cartTeam <= TEAM_HORDE; ++cartTeam)
+    {
+        if (m_flagKeepers[cartTeam] != guid)
+            continue;
+
+        if (player)
+            EventPlayerDroppedFlag(player);
+        else
+        {
+            // The carrier is gone without a chance to drop the cart, it goes back to its base
+            SF_LOG_ERROR("bg.battleground", "BattlegroundDG: Removing an offline player who has a cart!");
+            m_flagKeepers[cartTeam] = 0;
+            m_flagState[cartTeam] = BG_DG_CART_STATE_ON_BASE;
+            UpdateTeamScore(cartTeam, m_flagGold[cartTeam]);
+            m_flagGold[cartTeam] = 0;
+            UpdateCartState(cartTeam == TEAM_ALLIANCE ? TEAM_HORDE : TEAM_ALLIANCE, BG_DG_CART_STATE_ON_BASE);
+            SpawnBGObject(BG_DG_OBJECT_CART_ALLIANCE + cartTeam, RESPAWN_IMMEDIATELY);
+        }
+    }
+}
