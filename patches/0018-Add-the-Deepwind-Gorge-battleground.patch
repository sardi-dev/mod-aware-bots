+* ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+* FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for
+* more details.
+*
+* You should have received a copy of the GNU General Public License along
+* with this program. If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#include "BattlegroundDG.h"
+#include "ScriptedCreature.h"
+#include "ScriptMgr.h"
+#include "SpellAuraEffects.h"
+#include "SpellScript.h"
+#include "TemporarySummon.h"
+
+enum DeepwindGorge
+{
+    NPC_DG_ALLIANCE_MINE_CART   = 71071,
+    NPC_DG_HORDE_MINE_CART      = 71073,
+
+    SPELL_TRACK_MINE_CART       = 52595,
+
+    EVENT_NEW_WAYPOINT          = 1
+};
+
+// The cart follows the player carrying it, 71071 and 71073
+struct npc_dg_cart : public ScriptedAI
+{
+    npc_dg_cart(Creature* creature) : ScriptedAI(creature)
+    {
+        me->SetReactState(REACT_PASSIVE);
+    }
+
+    void UpdateAI(uint32 diff) OVERRIDE
+    {
+        events.Update(diff);
+
+        Unit* owner = me->GetOwner();
+        if (!owner || me->GetDistance(owner) <= 5.0f)
+            return;
+
+        me->SetSpeed(MOVE_RUN, (owner->GetSpeed(MOVE_RUN) + 1.0f) / playerBaseMoveSpeed[MOVE_RUN], true);
+        if (!me->isMoving() && events.Empty())
+            events.ScheduleEvent(EVENT_NEW_WAYPOINT, 700);
+
+        if (events.ExecuteEvent() == EVENT_NEW_WAYPOINT)
+            me->GetMotionMaster()->MoveChase(owner, frand(0.5f, 1.0f), frand(0.0f, 2.0f * M_PI));
+
+        if (!me->HasAura(SPELL_TRACK_MINE_CART))
+            owner->CastSpell(me, SPELL_TRACK_MINE_CART, true);
+    }
+
+private:
+    EventMap events;
+};
+
+// 140876 - Alliance Mine Cart, 141210 - Horde Mine Cart
+class spell_dg_mine_cart : public AuraScript
+{
+    PrepareAuraScript(spell_dg_mine_cart);
+
+    // The cart goes with the aura
+    void HandleOnRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        uint32 entry = GetSpellInfo()->Id == BG_DG_HORDE_MINE_CART ? NPC_DG_HORDE_MINE_CART : NPC_DG_ALLIANCE_MINE_CART;
+
+        std::list<Creature*> carts;
+        GetTarget()->GetCreatureListWithEntryInGrid(carts, entry, 500.0f);
+        for (std::list<Creature*>::iterator itr = carts.begin(); itr != carts.end(); ++itr)
+            if (TempSummon* cart = (*itr)->ToTempSummon())
+                cart->UnSummon();
+    }
+
+    void Register() OVERRIDE
+    {
+        OnEffectRemove += AuraEffectRemoveFn(spell_dg_mine_cart::HandleOnRemove, EFFECT_3, SPELL_AURA_428, AURA_EFFECT_HANDLE_REAL);
+    }
+};
+
+void AddSC_deepwind_gorge()
+{
+    RegisterCreatureAI(npc_dg_cart);
+    RegisterAuraScript(spell_dg_mine_cart);
+}
