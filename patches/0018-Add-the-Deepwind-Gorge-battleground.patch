+uint32 const BG_DG_CartPickedUpSounds[BG_TEAMS_COUNT]   = { BG_DG_SOUND_ALLIANCE_CART_PICKED_UP, BG_DG_SOUND_HORDE_CART_PICKED_UP };
+uint32 const BG_DG_CartCapturedSounds[BG_TEAMS_COUNT]   = { BG_DG_SOUND_CART_CAPTURED_ALLIANCE, BG_DG_SOUND_CART_CAPTURED_HORDE };
+
+// Auras of the capture point creature in the order of BG_DG_NodeStatus
