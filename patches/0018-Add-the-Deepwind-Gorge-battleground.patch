+uint8 BattlegroundDG::CountOccupiedNodes(uint8 team) const
+{
+    uint8 count = 0;
+    for (uint8 i = 0; i < BG_DG_ALL_NODES_COUNT; ++i)
+        if (m_nodes[i] == BG_DG_NODE_TYPE_OCCUPIED + team)
+            ++count;
+
+    return count;
+}
+
+void BattlegroundDG::FillInitialWorldStates(WorldStateBuilder& builder)
+{
+    builder.AppendState(WORLDSTATE_DG_CART_STATE_ALLIANCE, m_flagState[TEAM_HORDE] == BG_DG_CART_STATE_ON_PLAYER ? 2 : 1);
+    builder.AppendState(WORLDSTATE_DG_CART_STATE_HORDE, m_flagState[TEAM_ALLIANCE] == BG_DG_CART_STATE_ON_PLAYER ? 2 : 1);
+
+    // The occupied states of a node share one world state, so it is only sent once with the value of the owner
+    for (uint8 node = 0; node < BG_DG_ALL_NODES_COUNT; ++node)
+    {
+        for (uint8 status = BG_DG_NODE_TYPE_NEUTRAL; status <= BG_DG_NODE_STATUS_HORDE_OCCUPIED; ++status)
+        {
+            if (status >= BG_DG_NODE_TYPE_OCCUPIED && m_nodes[node] >= BG_DG_NODE_TYPE_OCCUPIED && m_nodes[node] != status)
+                continue;
+
+            builder.AppendState(BG_DG_NodesWs[node][status].worldState, m_nodes[node] == status ? BG_DG_NodesWs[node][status].shownValue : 0);
+        }
+    }
+
+    builder.AppendState(WORLDSTATE_DG_OCCUPIED_BASES_ALLIANCE, CountOccupiedNodes(TEAM_ALLIANCE));
+    builder.AppendState(WORLDSTATE_DG_OCCUPIED_BASES_HORDE, CountOccupiedNodes(TEAM_HORDE));
+
+    builder.AppendState(WORLDSTATE_DG_SCORE_ALLIANCE, m_TeamScores[TEAM_ALLIANCE]);
+    builder.AppendState(WORLDSTATE_DG_SCORE_HORDE, m_TeamScores[TEAM_HORDE]);
+}
+
+void BattlegroundDG::UpdatePlayerScore(Player* source, uint32 type, uint32 value, bool doAddHonor)
+{
+    BattlegroundScoreMap::iterator itr = PlayerScores.find(source->GetGUID());
+    if (itr == PlayerScores.end())
+        return;
+
+    BattlegroundDGScore* score = (BattlegroundDGScore*)itr->second;
+    switch (type)
+    {
+        case SCORE_CART_CAPTURES:
+            score->CapturedCart += value;
+            source->UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_BG_OBJECTIVE_CAPTURE, OBJECTIVE_CAPTURE_CART, 1);
+            break;
+        case SCORE_CART_RETURNS:
+            score->ReturnedCart += value;
+            source->UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_BG_OBJECTIVE_CAPTURE, OBJECTIVE_RETURN_CART, 1);
+            break;
+        case SCORE_BASES_ASSAULTED:
+            score->AssaultedMines += value;
+            source->UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_BG_OBJECTIVE_CAPTURE, OBJECTIVE_ASSAULT_MINE, 1);
+            break;
+        case SCORE_BASES_DEFENDED:
+            score->DefendedMines += value;
+            source->UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_BG_OBJECTIVE_CAPTURE, OBJECTIVE_DEFEND_MINE, 1);
+            break;
+        default:
+            Battleground::UpdatePlayerScore(source, type, value, doAddHonor);
+            break;
+    }
+}
