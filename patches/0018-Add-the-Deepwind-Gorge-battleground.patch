+    BG_DG_CAPT_POINT_ALLIANCE_CONTEST,
+    BG_DG_CAPT_POINT_HORDE_CONTEST,
+    BG_DG_CAPT_POINT_ALLIANCE_CONTROL,
+    BG_DG_CAPT_POINT_HORDE_CONTROL
+};
+
+uint32 const BG_DG_AuraEntries[3] = { BG_DG_OBJECTID_AURA_A, BG_DG_OBJECTID_AURA_H, BG_DG_OBJECTID_AURA_C };
+
+static ChatMsg TeamChatMsg(uint8 team)
+{
+    return team == TEAM_ALLIANCE ? ChatMsg::CHAT_MSG_BG_SYSTEM_ALLIANCE : ChatMsg::CHAT_MSG_BG_SYSTEM_HORDE;
+}
