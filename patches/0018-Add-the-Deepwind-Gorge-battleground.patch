+/************************************************************************/
+/*                          NODES UPDATES                               */
+/************************************************************************/
+void BattlegroundDG::ChangeBanner(uint8 node, uint8 type)
+{
+    // 1. Manage auras objects, the owner has a control aura and a contested node the neutral one
+    if (type == BG_DG_NODE_TYPE_CONTESTED && m_prevNodes[node] >= BG_DG_NODE_TYPE_OCCUPIED)
+    {
+        SpawnBGObject(node * BG_DG_OBJECT_DYNAMIC_TOTAL + BG_DG_OBJECT_AURA_ALLY + (m_prevNodes[node] - BG_DG_NODE_TYPE_OCCUPIED), RESPAWN_ONE_DAY);
+        SpawnBGObject(node * BG_DG_OBJECT_DYNAMIC_TOTAL + BG_DG_OBJECT_AURA_CONTESTED, RESPAWN_IMMEDIATELY);
+    }
+    else if (type == BG_DG_NODE_TYPE_OCCUPIED && m_prevNodes[node] != BG_DG_NODE_TYPE_NEUTRAL && m_prevNodes[node] < BG_DG_NODE_TYPE_OCCUPIED)
+    {
+        SpawnBGObject(node * BG_DG_OBJECT_DYNAMIC_TOTAL + BG_DG_OBJECT_AURA_CONTESTED, RESPAWN_ONE_DAY);
+        SpawnBGObject(node * BG_DG_OBJECT_DYNAMIC_TOTAL + BG_DG_OBJECT_AURA_ALLY + (m_nodes[node] - BG_DG_NODE_TYPE_OCCUPIED), RESPAWN_IMMEDIATELY);
+    }
+
+    // 2. Manage the capture point
+    Creature* capturePoint = GetBgMap()->GetCreature(BgCreatures[BG_DG_OBJECT_CAPT_POINT_START + node]);
+    if (!capturePoint)
+        return;
+
+    capturePoint->RemoveAurasDueToSpell(BG_DG_CapturePointAuras[m_prevNodes[node]]);
+    capturePoint->CastSpell(capturePoint, BG_DG_CapturePointAuras[m_nodes[node]], true);
+
+    // The clickable flag differs by team, so the creature is sent again
+    for (BattlegroundPlayerMap::const_iterator itr = m_Players.begin(); itr != m_Players.end(); ++itr)
+        if (Player* player = ObjectAccessor::FindPlayer(itr->first))
+            capturePoint->SendUpdateToPlayer(player);
+}
+
+void BattlegroundDG::SendNodeUpdate(uint8 node)
+{
+    UpdateWorldState(BG_DG_NodesWs[node][m_prevNodes[node]].worldState, 0);
+    UpdateWorldState(BG_DG_NodesWs[node][m_nodes[node]].worldState, BG_DG_NodesWs[node][m_nodes[node]].shownValue);
+
+    UpdateWorldState(WORLDSTATE_DG_OCCUPIED_BASES_ALLIANCE, CountOccupiedNodes(TEAM_ALLIANCE));
+    UpdateWorldState(WORLDSTATE_DG_OCCUPIED_BASES_HORDE, CountOccupiedNodes(TEAM_HORDE));
+}
+
+// A team can only click a capture point that is neutral or not held by its own team
+bool BattlegroundDG::CanSeeSpellClick(Player const* player, Unit const* clicked)
+{
+    for (uint8 i = 0; i < BG_DG_ALL_NODES_COUNT; ++i)
+    {
+        if (clicked->GetGUID() != BgCreatures[BG_DG_OBJECT_CAPT_POINT_START + i])
+            continue;
+
+        // Alliance has the team index 0 and the odd node states, Horde the index 1 and the even ones
+        return m_nodes[i] == BG_DG_NODE_TYPE_NEUTRAL || GetTeamIndexByTeamId(player->GetBGTeam()) != m_nodes[i] % 2;
+    }
+
+    return true;
+}
+
+void BattlegroundDG::EventPlayerClickedOnFlag(Player* source, Unit* flag)
+{
+    if (GetStatus() != STATUS_IN_PROGRESS || !flag)
+        return;
+
+    uint8 node = 0;
+    while (node < BG_DG_ALL_NODES_COUNT && BgCreatures[BG_DG_OBJECT_CAPT_POINT_START + node] != flag->GetGUID())
+        ++node;
+
+    // The click was not on a capture point
+    if (node == BG_DG_ALL_NODES_COUNT || !source->IsWithinDistInMap(flag, 10.0f))
+        return;
+
+    uint8 teamIndex = GetTeamIndexByTeamId(source->GetBGTeam());
+    if (!CanSeeSpellClick(source, flag))
+        return;
+
+    source->RemoveAurasWithInterruptFlags(AURA_INTERRUPT_FLAG_ENTER_PVP_COMBAT);
+
+    uint32 soundId = BG_DG_SOUND_NODE_CLAIMED;
+    uint8 oldState = m_nodes[node];
+    bool assault = true;
+
+    if (oldState == BG_DG_NODE_TYPE_NEUTRAL)
+    {
+        SendMessage2ToAll(LANG_BG_DG_NODE_CLAIMED, TeamChatMsg(teamIndex), source, GetNodeNameId(node), LANG_BG_DG_ALLY + teamIndex);
+    }
+    else if (oldState == BG_DG_NODE_STATUS_ALLY_CONTESTED || oldState == BG_DG_NODE_STATUS_HORDE_CONTESTED)
+    {
+        soundId = teamIndex == TEAM_ALLIANCE ? BG_DG_SOUND_NODE_ASSAULTED_ALLIANCE : BG_DG_SOUND_NODE_ASSAULTED_HORDE;
+
+        if (m_prevNodes[node] < BG_DG_NODE_TYPE_OCCUPIED)
+            SendMessage2ToAll(LANG_BG_DG_NODE_CLAIMED, TeamChatMsg(teamIndex), source, GetNodeNameId(node), LANG_BG_DG_ALLY + teamIndex);
+        else
+        {
+            // The owner takes the node back
+            assault = false;
+            SendMessage2ToAll(LANG_BG_DG_NODE_DEFENDED, TeamChatMsg(teamIndex), source, GetNodeNameId(node));
+        }
+    }
+    else
+    {
+        soundId = teamIndex == TEAM_ALLIANCE ? BG_DG_SOUND_NODE_ASSAULTED_ALLIANCE : BG_DG_SOUND_NODE_ASSAULTED_HORDE;
+        SendMessage2ToAll(LANG_BG_DG_NODE_ASSAULTED, ChatMsg::CHAT_MSG_BG_SYSTEM_NEUTRAL, source, GetNodeNameId(node));
+    }
+
+    UpdatePlayerScore(source, assault ? SCORE_BASES_ASSAULTED : SCORE_BASES_DEFENDED, 1);
+    m_prevNodes[node] = oldState;
+    m_nodes[node] = (assault ? BG_DG_NODE_TYPE_CONTESTED : BG_DG_NODE_TYPE_OCCUPIED) + teamIndex;
+    m_nodeTimers[node] = assault ? BG_DG_FLAG_CAPTURING_TIME : 0;
+    ChangeBanner(node, assault ? BG_DG_NODE_TYPE_CONTESTED : BG_DG_NODE_TYPE_OCCUPIED);
+    SendNodeUpdate(node);
+
+    if (m_nodes[node] >= BG_DG_NODE_TYPE_OCCUPIED)
+        SendMessage2ToAll(LANG_BG_DG_NODE_TAKEN, TeamChatMsg(teamIndex), source, LANG_BG_DG_ALLY + teamIndex, GetNodeNameId(node));
+
+    PlaySoundToAll(soundId);
+}
+
+void BattlegroundDG::PostUpdateImplFlags(uint32 diff)
+{
+    for (uint8 node = 0; node < BG_DG_ALL_NODES_COUNT; ++node)
+        // 1-minute to occupy a node from contested state
+        ContestedTime(node, diff);
+
+    for (uint8 team = TEAM_ALLIANCE; team <= TEAM_HORDE; ++team)
+    {
+        uint8 points = CountOccupiedNodes(team);
+        if (!points)
+            continue;
+
+        m_lastTick[team] += diff;
+        if (m_lastTick[team] <= BG_DG_TickIntervals[points])
+            continue;
+
+        m_lastTick[team] -= BG_DG_TickIntervals[points];
+        m_honorScoreTics[team] += BG_DG_TickPoints[points];
+        if (m_honorScoreTics[team] >= m_honorTicks)
+        {
+            RewardHonorToTeam(GetBonusHonorFromKill(1), team == TEAM_ALLIANCE ? ALLIANCE : HORDE);
+            m_honorScoreTics[team] -= m_honorTicks;
+        }
+
+        // Needs to be last, the tick can end the battleground
+        UpdateTeamScore(team, BG_DG_TickPoints[points]);
+    }
+}
+
+void BattlegroundDG::ContestedTime(uint8 node, uint32 diff)
+{
+    if (m_nodeTimers[node] == 0)
+        return;
+
+    if (m_nodeTimers[node] > diff)
+    {
+        m_nodeTimers[node] -= diff;
+        return;
+    }
+
+    // Change from contested to occupied
+    m_nodeTimers[node] = 0;
+    uint8 teamIndex = m_nodes[node] - BG_DG_NODE_TYPE_CONTESTED;
+    m_prevNodes[node] = m_nodes[node];
+    m_nodes[node] += 2;
+    ChangeBanner(node, BG_DG_NODE_TYPE_OCCUPIED);
+    SendNodeUpdate(node);
+    SendMessage2ToAll(LANG_BG_DG_NODE_TAKEN, TeamChatMsg(teamIndex), NULL, LANG_BG_DG_ALLY + teamIndex, GetNodeNameId(node));
+    PlaySoundToAll(teamIndex == TEAM_ALLIANCE ? BG_DG_SOUND_NODE_CAPTURED_ALLIANCE : BG_DG_SOUND_NODE_CAPTURED_HORDE);
+}
+
+int32 BattlegroundDG::GetNodeNameId(uint8 node)
+{
+    switch (node)
+    {
+        case BG_DG_NODE_GOBLIN_MINE:
+            return LANG_BG_DG_NODE_GOBLIN_MINE;
+        case BG_DG_NODE_CENTER_MINE:
+            return LANG_BG_DG_NODE_CENTER_MINE;
+        case BG_DG_NODE_PANDAREN_MINE:
+            return LANG_BG_DG_NODE_PANDAREN_MINE;
+        default:
+            break;
+    }
+
+    return 0;
+}
