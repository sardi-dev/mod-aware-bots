+*/
+
+#include "BattlegroundVOP.h"
+#include "Player.h"
+#include "ScriptMgr.h"
+#include "SpellAuraEffects.h"
+#include "SpellScript.h"
+
+enum TempleOfKotmogu
+{
+    ORB_EFFECT_SCALE         = 4,
+    ORB_SCALE_PER_TICK       = 5
+};
+
+// 121164, 121175, 121176, 121177 - Orb of Power
+class spell_kotmogu_orb_of_power : public AuraScript
+{
+    PrepareAuraScript(spell_kotmogu_orb_of_power);
+
+    // The orb goes back to its pedestal when the aura ends
+    void HandleOnRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        if (Player* player = GetTarget()->ToPlayer())
+            if (Battleground* bg = player->GetBattleground())
+                if (bg->GetTypeID(true) == BattlegroundTypeId::BATTLEGROUND_VOP)
+                    static_cast<BattlegroundVOP*>(bg)->ReleaseOrb(player);
+    }
+
+    // Every tick adds the base amount again to the damage, healing and damage taken effects and makes the carrier bigger
+    void HandleTick(AuraEffect const* /*aurEff*/)
+    {
+        for (uint8 effIndex = EFFECT_0; effIndex <= EFFECT_2; ++effIndex)
+            if (AuraEffect* effect = GetAura()->GetEffect(effIndex))
+                effect->ChangeAmount(effect->GetAmount() + effect->GetBaseAmount());
+
+        if (AuraEffect* scale = GetAura()->GetEffect(ORB_EFFECT_SCALE))
+            scale->ChangeAmount(scale->GetAmount() + ORB_SCALE_PER_TICK);
+    }
+
+    void Register() OVERRIDE
+    {
+        OnEffectRemove += AuraEffectRemoveFn(spell_kotmogu_orb_of_power::HandleOnRemove, EFFECT_3, SPELL_AURA_PERIODIC_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_kotmogu_orb_of_power::HandleTick, EFFECT_3, SPELL_AURA_PERIODIC_DUMMY);
+    }
+};
+
+void AddSC_temple_of_kotmogu()
+{
+    RegisterAuraScript(spell_kotmogu_orb_of_power);
+}
