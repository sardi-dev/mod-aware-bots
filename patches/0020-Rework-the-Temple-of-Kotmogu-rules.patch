+// The points a carrier scores depend on where it stands: 3 outside, 4 in the middle ring and 5 in the centre
+uint32 BattlegroundVOP::GetCarrierPoints(Player const* player) const
+{
+    uint32 points = 3;
+    uint32 const triggers[2] = { BG_VOP_TRIGGER_MIDDLE_RING, BG_VOP_TRIGGER_CENTRE };
+    for (uint8 i = 0; i < 2; ++i)
     {
-        score = BG_VOP_MAX_TEAM_SCORE;
-        if (Team == TEAM_ALLIANCE)
-            EndBattleground(ALLIANCE);
-        else
-            EndBattleground(HORDE);
+        AreaTriggerEntry const* trigger = sAreaTriggerStore.LookupEntry(triggers[i]);
+        if (!trigger)
+            break;
+
+        // the trigger boxes are turned around their centre, so turn the player the other way
+        double rotation = 2 * M_PI - trigger->box_orientation;
+        float dx = player->GetPositionX() - trigger->x;
+        float dy = player->GetPositionY() - trigger->y;
+        float rotX = float(dx * std::cos(rotation) - dy * std::sin(rotation));
+        float rotY = float(dy * std::cos(rotation) + dx * std::sin(rotation));
+        if (fabs(rotX) > trigger->box_x / 2 || fabs(rotY) > trigger->box_y / 2)
+            break;
+
+        ++points;
     }
 
+    return points;
+}
+
+void BattlegroundVOP::UpdateTeamScore(uint32 Team)
+{
+    uint32 score = GetTeamScore(Team);
+
     if (Team == TEAM_ALLIANCE)
         UpdateWorldState(BG_VOP_OP_RESOURCES_A, score);
     else
         UpdateWorldState(BG_VOP_OP_RESOURCES_H, score);
+
+    if (score >= BG_VOP_MAX_TEAM_SCORE)
+        EndBattleground(Team == TEAM_ALLIANCE ? ALLIANCE : HORDE);
+}
+
+void BattlegroundVOP::AddScore(Player* player, uint32 value)
+{
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    uint32 team = player->GetBGTeam() == ALLIANCE ? TEAM_ALLIANCE : TEAM_HORDE;
+
+    m_TeamScores[team] = std::min<int32>(m_TeamScores[team] + value, BG_VOP_MAX_TEAM_SCORE);
+    m_LastScoreTeam = player->GetBGTeam();
+    UpdatePlayerScore(player, SCORE_ORB_SCORE, value);
+
+    m_HonorScoreTics[team] += value;
+    while (m_HonorScoreTics[team] >= m_HonorTics)
+    {
+        RewardHonorToTeam(GetBonusHonorFromKill(1), player->GetBGTeam());
+        m_HonorScoreTics[team] -= m_HonorTics;
+    }
+
+    UpdateTeamScore(team);
 }
 
