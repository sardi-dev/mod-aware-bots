+
+void BattlegroundVOP::DropOrb(uint8 index, Player* player)
+{
+    // Forget the keeper first: removing the orb aura calls ReleaseOrb again
+    m_OrbKeepers[index] = 0;
+    m_OrbTimers[index] = 0;
+
+    if (player)
+    {
+        player->RemoveAurasDueToSpell(BG_VOP_SPELL_ALLIANCE_INSIGNIA);
+        player->RemoveAurasDueToSpell(BG_VOP_SPELL_HORDE_INSIGNIA);
+        player->RemoveAurasDueToSpell(BG_VOP_OrbSpells[index]);
+    }
+
+    PlaySoundToAll(BG_VOP_SOUND_ORB);
+    SpawnBGObject(BG_VOP_OBJECT_ORB_1 + index, RESPAWN_IMMEDIATELY);
+    if (Creature* aura = GetBGCreature(BG_VOP_CREATURE_ORB_AURA_1 + index))
+        aura->AddAura(BG_VOP_OrbAuras[index], aura);
+
+    UpdateWorldState(BG_VOP_OrbWorldStates[index], 1);
+    SendMessageToAll(BG_VOP_DroppedStrings[index], ChatMsg::CHAT_MSG_RAID_BOSS_EMOTE, player);
 }
 
