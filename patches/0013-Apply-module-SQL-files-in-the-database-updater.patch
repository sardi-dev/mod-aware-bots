+        std::vector<SqlUpdateFile> DiscoverSqlUpdatesInDirectory(std::filesystem::path directory)
+        {
+            directory.make_preferred();
+            if (!std::filesystem::exists(directory) || !std::filesystem::is_directory(directory))
+                return {};
+
+            std::vector<std::string> names;
+            for (std::filesystem::directory_entry const& entry : std::filesystem::directory_iterator(directory))
+            {
+                if (entry.is_regular_file())
+                    names.push_back(entry.path().filename().string());
+            }
+
+            std::vector<SqlUpdateFile> updates = BuildSortedSqlUpdateList(names, directory.string());
+            for (SqlUpdateFile& update : updates)
+            {
+                std::string contents;
+                if (ReadTextFile(update.Path, contents))
+                    update.Hash = CalculateStableSqlHash(contents);
+            }
+
+            return updates;
+        }
+
+        // Module files are recorded as "<module>/<file>" in the same tracking table, so they can never
+        // collide with a core update and the module is visible in the audit rows.
+        std::vector<SqlUpdateFile> AppendModuleSqlUpdates(SetupOptions const& options,
+            std::vector<SqlUpdateFile> updates)
+        {
+            if (!options.ImportModuleUpdates || options.ModuleUpdatesDirectory.empty())
+                return updates;
+
+            std::filesystem::path modulesPath = options.ModulesSqlPath.empty()
+                ? std::filesystem::path(options.SqlPath) / ".." / "modules"
+                : std::filesystem::path(options.ModulesSqlPath);
+            modulesPath = modulesPath.lexically_normal().make_preferred();
+            if (!std::filesystem::exists(modulesPath) || !std::filesystem::is_directory(modulesPath))
+                return updates;
+
+            std::vector<std::string> modules;
+            for (std::filesystem::directory_entry const& entry : std::filesystem::directory_iterator(modulesPath))
+            {
+                if (entry.is_directory())
+                    modules.push_back(entry.path().filename().string());
+            }
+
+            std::sort(modules.begin(), modules.end());
+            for (std::string const& module : modules)
+            {
+                std::vector<SqlUpdateFile> moduleUpdates =
+                    DiscoverSqlUpdatesInDirectory(modulesPath / module / options.ModuleUpdatesDirectory);
+                for (SqlUpdateFile& update : moduleUpdates)
+                {
+                    update.Name = module + "/" + update.Name;
+                    update.Module = module;
+                    updates.push_back(std::move(update));
+                }
+            }
+
+            return updates;
+        }
     }
 
