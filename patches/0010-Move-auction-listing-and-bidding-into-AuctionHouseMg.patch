+AuctionListResult AuctionHouseMgr::ListItem(Player* seller, Creature* auctioneer, uint64 itemGuid, uint32 count, uint64 bid, uint64 buyout, uint32 hours, AuctionListOutcome& outcome)
+{
+    if (!bid || bid > MAX_MONEY_AMOUNT || buyout > MAX_MONEY_AMOUNT)
+        return AuctionListResult::InvalidPrice;
+
+    // Rejected before the multiplication, a huge value could wrap around to a valid duration.
+    if (hours > 4 * MIN_AUCTION_TIME / HOUR)
+        return AuctionListResult::InvalidDuration;
+
+    uint32 duration = hours * HOUR;
+    if (!Skyfire::Auction::IsValidDuration(duration, MIN_AUCTION_TIME))
+        return AuctionListResult::InvalidDuration;
+
+    AuctionHouseEntry const* auctionHouseEntry = GetAuctionHouseEntry(auctioneer->getFaction());
+    if (!auctionHouseEntry)
+        return AuctionListResult::InvalidAuctioneer;
+
+    Item* item = seller->GetItemByGuid(itemGuid);
+    if (!item)
+        return AuctionListResult::ItemNotFound;
+
+    // Splitting a stack needs a clone of the item, only whole stacks are listed here.
+    if (!count || count != item->GetCount())
+        return AuctionListResult::InvalidCount;
+
+    if (!CanAuctionItem(item, count))
+        return AuctionListResult::ItemNotAllowed;
+
+    uint64 deposit = GetAuctionDeposit(auctionHouseEntry, duration, item, count);
+    if (!seller->HasEnoughMoney(deposit))
+        return AuctionListResult::NotEnoughMoney;
+
+    uint32 auctionTime = uint32(duration * sWorld->getRate(Rates::RATE_AUCTION_TIME));
+    AuctionEntry* auction = CreateAuction(seller, item, auctioneer, bid, buyout, auctionTime, deposit);
+
+    SF_LOG_DEBUG("auctionHouse", "Player %u lists item %u (count %u) as auction %u for " UI64FMTD " with buyout " UI64FMTD,
+        seller->GetGUIDLow(), item->GetEntry(), count, auction->Id, bid, buyout);
+
+    seller->MoveItemFromInventory(item->GetBagSlot(), item->GetSlot(), true);
+    seller->ModifyMoney(-int64(deposit));
+
+    SQLTransaction trans = CharacterDatabase.BeginTransaction();
+    item->DeleteFromInventoryDB(trans);
+    item->SaveToDB(trans);
+    auction->SaveToDB(trans);
+    seller->SaveInventoryAndGoldToDB(trans);
+    CharacterDatabase.CommitTransaction(trans);
+
+    seller->UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_CREATE_AUCTION, 1);
+
+    outcome.auctionId = auction->Id;
+    outcome.deposit = deposit;
+    return AuctionListResult::Ok;
+}
+
+AuctionBidResult AuctionHouseMgr::PlaceBid(Player* bidder, AuctionHouseObject* auctionHouse, uint32 auctionId, uint64 price, AuctionBidOutcome& outcome)
+{
+    outcome.paid = 0;
+    outcome.boughtOut = false;
+
+    AuctionEntry* auction = auctionHouse->GetAuction(auctionId);
+    if (!auction)
+        return AuctionBidResult::NotFound;
+
+    outcome.auction = *auction;
+
+    if (auction->owner == bidder->GetGUIDLow())
+        return AuctionBidResult::OwnAuction;
+
+    switch (Skyfire::Auction::CheckBid(price, auction->bid, auction->startbid, auction->buyout, auction->GetAuctionOutBid()))
+    {
+        case Skyfire::Auction::BidCheck::Ignored:
+            return AuctionBidResult::InvalidPrice;
+        case Skyfire::Auction::BidCheck::TooLow:
+            return AuctionBidResult::BidTooLow;
+        default:
+            break;
+    }
+
+    // The whole price has to be there even for the current bidder, who only pays the difference.
+    if (!bidder->HasEnoughMoney(price))
+        return AuctionBidResult::NotEnoughMoney;
+
+    bool const isBuyout = auction->buyout && price >= auction->buyout;
+    bool const isCurrentBidder = auction->bidder == bidder->GetGUIDLow();
+
+    SQLTransaction trans = CharacterDatabase.BeginTransaction();
+
+    outcome.paid = Skyfire::Auction::GetBidCost(price, auction->bid, auction->buyout, isCurrentBidder);
+
+    if (!isBuyout)
+    {
+        // mail to last bidder and return money
+        if (auction->bidder && !isCurrentBidder)
+            SendAuctionOutbiddedMail(auction, price, bidder, trans);
+
+        bidder->ModifyMoney(-int64(outcome.paid));
+
+        auction->bidder = bidder->GetGUIDLow();
+        auction->bid = price;
+        bidder->UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_HIGHEST_AUCTION_BID, price);
+
+        PreparedStatement* stmt = CharacterDatabase.GetPreparedStatement(CHAR_UPD_AUCTION_BID);
+        stmt->setUInt32(0, auction->bidder);
+        stmt->setUInt64(1, auction->bid);
+        stmt->setUInt32(2, auction->Id);
+        trans->Append(stmt);
+
+        outcome.auction = *auction;
+    }
+    else
+    {
+        bidder->ModifyMoney(-int64(outcome.paid));
+        if (auction->bidder && !isCurrentBidder)            //buyout for bidded auction ..
+            SendAuctionOutbiddedMail(auction, auction->buyout, bidder, trans);
+
+        auction->bidder = bidder->GetGUIDLow();
+        auction->bid = auction->buyout;
+        bidder->UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_HIGHEST_AUCTION_BID, auction->buyout);
+
+        //- Mails must be under transaction control too to prevent data loss
+        SendAuctionSalePendingMail(auction, trans);
+        SendAuctionSuccessfulMail(auction, trans);
+        SendAuctionWonMail(auction, trans);
+        sScriptMgr->OnAuctionSuccessful(auctionHouse, auction);
+
+        auction->DeleteFromDB(trans);
+
+        outcome.auction = *auction;
+        outcome.boughtOut = true;
+
+        RemoveAItem(auction->itemGUIDLow);
+        auctionHouse->RemoveAuction(auction, outcome.auction.itemEntry);
+    }
+
+    bidder->SaveInventoryAndGoldToDB(trans);
+    CharacterDatabase.CommitTransaction(trans);
+
+    return AuctionBidResult::Ok;
+}
