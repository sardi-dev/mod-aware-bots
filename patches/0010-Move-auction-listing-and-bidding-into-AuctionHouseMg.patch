+bool AuctionHouseMgr::CanAuctionItem(Item* item, uint32 count)
+{
+    return !GetAItem(item->GetGUIDLow()) && item->CanBeTraded() && !item->IsNotEmptyBag() &&
+        !(item->GetTemplate()->Flags & ITEM_PROTO_FLAG_CONJURED) && !item->GetUInt32Value(ITEM_FIELD_EXPIRATION) &&
+        item->GetCount() >= count;
+}
