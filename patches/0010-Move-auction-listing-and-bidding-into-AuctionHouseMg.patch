+void AuctionHouseObject::GetListings(std::vector<AuctionListing>& listings, uint32 afterId, uint32 limit) const
+{
+    uint32 added = 0;
+    for (AuctionEntryMap::const_iterator itr = AuctionsMap.upper_bound(afterId); itr != AuctionsMap.end(); ++itr)
+    {
+        if (limit && added >= limit)
+            break;
+
+        AuctionEntry const* auction = itr->second;
+        Item* item = sAuctionMgr->GetAItem(auction->itemGUIDLow);
+        if (!item)
+            continue;
+
+        AuctionListing listing;
+        listing.id = auction->Id;
+        listing.itemEntry = auction->itemEntry;
+        listing.randomPropertyId = item->GetItemRandomPropertyId();
+        listing.itemCount = auction->itemCount;
+        listing.startBid = auction->startbid;
+        listing.bid = auction->bid;
+        listing.buyout = auction->buyout;
+        listing.owner = auction->owner;
+        listing.bidder = auction->bidder;
+        listing.expireTime = auction->expire_time;
+        listings.push_back(listing);
+        ++added;
+    }
+}
