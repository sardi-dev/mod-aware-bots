+AuctionEntry* AuctionHouseMgr::CreateAuction(Player* seller, Item* item, Creature* auctioneer, uint64 bid, uint64 buyout, uint32 auctionTime, uint64 deposit)
+{
+    AuctionEntry* auction = new AuctionEntry();
+
+    if (sWorld->GetBoolConfig(WorldBoolConfigs::CONFIG_ALLOW_TWO_SIDE_INTERACTION_AUCTION))
+        auction->auctioneer = 23442;     ///@TODO - HARDCODED DB GUID, BAD BAD BAD
+    else
+        auction->auctioneer = auctioneer->GetGUIDLow();
+
+    auction->Id = sObjectMgr->GenerateAuctionID();
+    auction->itemGUIDLow = item->GetGUIDLow();
+    auction->itemEntry = item->GetEntry();
+    auction->itemCount = item->GetCount();
+    auction->owner = seller->GetGUIDLow();
+    auction->startbid = bid;
+    auction->bidder = 0;
+    auction->bid = 0;
+    auction->buyout = buyout;
+    auction->expire_time = time(NULL) + auctionTime;
+    auction->deposit = deposit;
+    auction->auctionHouseEntry = GetAuctionHouseEntry(auctioneer->getFaction());
+
+    AddAItem(item);
+    GetAuctionsMap(auctioneer->getFaction())->AddAuction(auction);
+
+    return auction;
+}
