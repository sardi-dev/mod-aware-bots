+/*
+* This file is part of Project SkyFire https://www.projectskyfire.org.
+* See LICENSE.md file for Copyright information
+*/
+
+#ifndef SKYFIRE_AUCTION_RULES_H
+#define SKYFIRE_AUCTION_RULES_H
+
+#include "Define.h"
+
+namespace Skyfire
+{
+    namespace Auction
+    {
+        enum class BidCheck
+        {
+            Ok,
+            Ignored,                                        // a client never sends this, no answer is given
+            TooLow                                          // below the next minimum bid
+        };
+
+        // Listings last once, twice or four times the minimum time.
+        inline bool IsValidDuration(uint32 duration, uint32 minDuration)
+        {
+            return duration == minDuration || duration == 2 * minDuration || duration == 4 * minDuration;
+        }
+
+        // A price equal to the buyout is a buyout, so it does not need to clear the minimum increment.
+        inline BidCheck CheckBid(uint64 price, uint64 currentBid, uint64 startBid, uint64 buyout, uint64 minIncrement)
+        {
+            if (price <= currentBid || price < startBid)
+                return BidCheck::Ignored;
+
+            if ((price < buyout || buyout == 0) && price < currentBid + minIncrement)
+                return BidCheck::TooLow;
+
+            return BidCheck::Ok;
+        }
+
+        // The current highest bidder only pays the difference, everyone else pays the full amount.
+        inline uint64 GetBidCost(uint64 price, uint64 currentBid, uint64 buyout, bool isCurrentBidder)
+        {
+            uint64 amount = (buyout && price >= buyout) ? buyout : price;
+            return isCurrentBidder ? amount - currentBid : amount;
+        }
+    } // namespace Skyfire::Auction
+} // namespace Skyfire
+
+#endif
