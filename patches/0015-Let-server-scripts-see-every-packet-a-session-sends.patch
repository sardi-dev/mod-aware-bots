From a11dbefa4ffd28d2146346a7258bb9f80bef9e18 Mon Sep 17 00:00:00 2001
From: sardi-dev <134648583+sardi-dev@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:01:54 +0000
Subject: [PATCH 15/25] Let server scripts see every packet a session sends

Modules that run sessions without a socket, such as player bots,
never see the packets the server sends to those sessions, because
SendPacket returns before any hook when there is no socket. A new
ServerScript hook, OnSessionPacketSend, is called for every packet a
session sends, before the socket check, with the original packet as a
read-only reference so nothing is copied.
---
 src/server/game/Scripting/ScriptMgr.cpp | 7 +++++++
 src/server/game/Scripting/ScriptMgr.h   | 6 ++++++
 src/server/game/Server/WorldSession.cpp | 1 +
 3 files changed, 14 insertions(+)

diff --git a/src/server/game/Scripting/ScriptMgr.cpp b/src/server/game/Scripting/ScriptMgr.cpp
index 8a5f7dc55f..8d25675127 100644
--- a/src/server/game/Scripting/ScriptMgr.cpp
+++ b/src/server/game/Scripting/ScriptMgr.cpp
@@ -410,6 +410,13 @@ void ScriptMgr::OnPacketSend(WorldSocket* socket, WorldPacket packet)
     FOREACH_SCRIPT(ServerScript)->OnPacketSend(socket, packet);
 }
 
+void ScriptMgr::OnSessionPacketSend(WorldSession* session, WorldPacket const& packet)
+{
+    ASSERT(session);
+
+    FOREACH_SCRIPT(ServerScript)->OnSessionPacketSend(session, packet);
+}
+
 void ScriptMgr::OnUnknownPacketReceive(WorldSocket* socket, WorldPacket packet)
 {
     ASSERT(socket);
diff --git a/src/server/game/Scripting/ScriptMgr.h b/src/server/game/Scripting/ScriptMgr.h
index 5720e9ab47..dc33fd9e42 100644
--- a/src/server/game/Scripting/ScriptMgr.h
+++ b/src/server/game/Scripting/ScriptMgr.h
@@ -47,6 +47,7 @@ class Transport;
 class Unit;
 class Vehicle;
 class WorldPacket;
+class WorldSession;
 class WorldSocket;
 class WorldObject;
 
@@ -220,6 +221,10 @@ public:
     // Called when an invalid (unknown opcode) packet is received by a client. The packet is a reference to the orignal
     // packet; not a copy. This allows you to actually handle unknown packets (for whatever purpose).
     virtual void OnUnknownPacketReceive(WorldSocket* /*socket*/, WorldPacket& /*packet*/) { }
+
+    // Called for every packet a session sends, before it reaches the socket, also for sessions without one (bots
+    // run by a module). The packet is the original; do not keep a reference to it.
+    virtual void OnSessionPacketSend(WorldSession* /*session*/, WorldPacket const& /*packet*/) { }
 };
 
 class WorldScript : public ScriptObject
@@ -887,6 +892,7 @@ public: /* Initialization */
     void OnSocketClose(WorldSocket* socket, bool wasNew);
     void OnPacketReceive(WorldSocket* socket, WorldPacket packet);
     void OnPacketSend(WorldSocket* socket, WorldPacket packet);
+    void OnSessionPacketSend(WorldSession* session, WorldPacket const& packet);
     void OnUnknownPacketReceive(WorldSocket* socket, WorldPacket packet);
 
     /* WorldScript */
diff --git a/src/server/game/Server/WorldSession.cpp b/src/server/game/Server/WorldSession.cpp
index e95eaaed72..f14c40615d 100644
--- a/src/server/game/Server/WorldSession.cpp
+++ b/src/server/game/Server/WorldSession.cpp
@@ -230,6 +230,7 @@ void WorldSession::SendPacket(WorldPacket const* packet, bool forced /*= false*/
 {
     if (m_packetObserver)
         m_packetObserver(*packet);
+    sScriptMgr->OnSessionPacketSend(this, *packet);
 
     WorldSocket* socket = m_InstanceSocket ? m_InstanceSocket : m_Socket;
     if (!socket)
