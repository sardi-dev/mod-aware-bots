+MailResponseResult Player::TakeMailMoney(uint32 mailId, uint64 money, uint32& equipError)
+{
+    Mail* m = GetMail(mailId);
+    if (!m || !m->IsDelivered() || (money > 0 && m->money != money))
+        return MAIL_ERR_INTERNAL_ERROR;
+
+    if (!ModifyMoney(m->money, false))
+    {
+        equipError = EQUIP_ERR_TOO_MUCH_GOLD;
+        return MAIL_ERR_EQUIP_ERROR;
+    }
+
+    m->money = 0;
+    m->state = MailState::MAIL_STATE_CHANGED;
+    m_mailsUpdated = true;
+
+    // save money and mail to prevent cheating
+    SQLTransaction trans = CharacterDatabase.BeginTransaction();
+    SaveGoldToDB(trans);
+    _SaveMail(trans);
+    CharacterDatabase.CommitTransaction(trans);
+
+    return MAIL_OK;
+}
+
+MailResponseResult Player::TakeMailItem(uint32 mailId, uint32 itemGuidLow, uint32& equipError, uint32& itemCount)
+{
+    Mail* m = GetMail(mailId);
+    if (!m || !m->IsDelivered())
+        return MAIL_ERR_INTERNAL_ERROR;
+
+    // prevent cheating with skip client money check
+    if (!HasEnoughMoney(uint64(m->COD)))
+        return MAIL_ERR_NOT_ENOUGH_MONEY;
+
+    Item* it = GetMItem(itemGuidLow);
+    if (!it)
+        return MAIL_ERR_INTERNAL_ERROR;
+
+    ItemPosCountVec dest;
+    uint8 msg = CanStoreItem(NULL_BAG, NULL_SLOT, dest, it, false);
+    if (msg != EQUIP_ERR_OK)
+    {
+        equipError = msg;
+        return MAIL_ERR_EQUIP_ERROR;
+    }
+
+    SQLTransaction trans = CharacterDatabase.BeginTransaction();
+    m->RemoveItem(itemGuidLow);
+    m->removedItems.push_back(itemGuidLow);
+
+    if (m->COD > 0)                                     //if there is COD, take COD money from player and send them to sender by mail
+    {
+        uint64 sender_guid = MAKE_NEW_GUID(m->sender, 0, HIGHGUID_PLAYER);
+        Player* receiver = ObjectAccessor::FindPlayer(sender_guid);
+
+        uint32 sender_accId = 0;
+
+        if (GetSession()->HasPermission(rbac::RBAC_PERM_LOG_GM_TRADE))
+        {
+            std::string sender_name;
+            if (receiver)
+            {
+                sender_accId = receiver->GetSession()->GetAccountId();
+                sender_name = receiver->GetName();
+            }
+            else
+            {
+                // can be calculated early
+                sender_accId = sObjectMgr->GetPlayerAccountIdByGUID(sender_guid);
+
+                if (!sObjectMgr->GetPlayerNameByGUID(sender_guid, sender_name))
+                    sender_name = sObjectMgr->GetSkyFireStringForDBCLocale(LANG_UNKNOWN);
+            }
+            sLog->outCommand(GetSession()->GetAccountId(), "GM %s (Account: %u) receiver mail item: %s (Entry: %u Count: %u) and send COD money: " UI64FMTD " to player: %s (Account: %u)",
+                GetName().c_str(), GetSession()->GetAccountId(), it->GetTemplate()->Name1.c_str(), it->GetEntry(), it->GetCount(), m->COD, sender_name.c_str(), sender_accId);
+        }
+        else if (!receiver)
+            sender_accId = sObjectMgr->GetPlayerAccountIdByGUID(sender_guid);
+
+        // check player existence
+        if (receiver || sender_accId)
+        {
+            MailDraft(m->subject, "")
+                .AddMoney(m->COD)
+                .SendMailTo(trans, MailReceiver(receiver, m->sender), MailSender(MAIL_NORMAL, m->receiver), MAIL_CHECK_MASK_COD_PAYMENT);
+        }
+
+        ModifyMoney(-int64(m->COD));
+    }
+    m->COD = 0;
+    m->state = MailState::MAIL_STATE_CHANGED;
+    m_mailsUpdated = true;
+    RemoveMItem(it->GetGUIDLow());
+
+    itemCount = it->GetCount();                         // save counts before store and possible merge with deleting
+    it->SetState(ITEM_UNCHANGED);                       // need to set this state, otherwise item cannot be removed later, if neccessary
+    MoveItemToInventory(dest, it, true);
+
+    SaveInventoryAndGoldToDB(trans);
+    _SaveMail(trans);
+    CharacterDatabase.CommitTransaction(trans);
+
+    return MAIL_OK;
+}
+
+bool Player::DeleteEmptyMail(uint32 mailId)
+{
+    Mail* m = GetMail(mailId);
+    if (!m || !m->IsDelivered() || m->HasItems() || m->money || m->COD)
+        return false;
+
+    m->state = MailState::MAIL_STATE_DELETED;
+    m_mailsUpdated = true;
+
+    // the mail is freed by the save
+    SQLTransaction trans = CharacterDatabase.BeginTransaction();
+    _SaveMail(trans);
+    CharacterDatabase.CommitTransaction(trans);
+
+    return true;
+}
