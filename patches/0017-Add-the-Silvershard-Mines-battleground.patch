+// 97388, 124492 - Capturing (battleground capture points and track switches)
+class spell_gen_bg_capturing : public SpellScriptLoader
+{
+    public:
+        spell_gen_bg_capturing() : SpellScriptLoader("spell_gen_bg_capturing") { }
+
+        class spell_gen_bg_capturing_SpellScript : public SpellScript
+        {
+            PrepareSpellScript(spell_gen_bg_capturing_SpellScript);
+
+            bool Load() OVERRIDE
+            {
+                GetCaster()->RemoveAurasByType(SPELL_AURA_MOUNTED);
+                return true;
+            }
+
+            SpellCastResult CheckCast()
+            {
+                Player* caster = GetCaster()->ToPlayer();
+                if (!caster || caster->isTotalImmune() || caster->GetTotalAuraModifier(SPELL_AURA_DEFLECT_SPELLS) >= 100)
+                    return SpellCastResult::SPELL_FAILED_TRY_AGAIN;
+
+                if (!GetSpell()->GetCastTime() && caster->IsNonMeleeSpellCasted(false, true, true))
+                    return SpellCastResult::SPELL_FAILED_SPELL_IN_PROGRESS;
+
+                return SpellCastResult::SPELL_CAST_OK;
+            }
+
+            void Register() OVERRIDE
+            {
+                OnCheckCast += SpellCheckCastFn(spell_gen_bg_capturing_SpellScript::CheckCast);
+            }
+        };
+
+        SpellScript* GetSpellScript() const OVERRIDE
+        {
+            return new spell_gen_bg_capturing_SpellScript();
+        }
+};
