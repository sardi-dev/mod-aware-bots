+BattlegroundSM::~BattlegroundSM() { }
+
+void BattlegroundSM::Reset()
+{
+    Battleground::Reset();
+
+    bool isBGWeekEnd = sBattlegroundMgr->IsBGWeekend(GetTypeID());
+    m_honorTicks = isBGWeekEnd ? BG_SM_SMWEEKEND_HONOR_TICKS : BG_SM_NOT_SMWEEKEND_HONOR_TICKS;
+    m_HonorWinKills = isBGWeekEnd ? 3 : 1;
+    m_HonorEndKills = isBGWeekEnd ? 4 : 2;
+
+    m_TeamScores[TEAM_ALLIANCE] = 0;
+    m_TeamScores[TEAM_HORDE] = 0;
+    m_HonorScoreTics[TEAM_ALLIANCE] = 0;
+    m_HonorScoreTics[TEAM_HORDE] = 0;
+    m_mineCartCheckTimer = IN_MILLISECONDS;
+    m_mineCartAddPointsTimer = 2 * IN_MILLISECONDS;
+    m_isInformedNearVictory = false;
+    m_mineCartsSpawned = false;
+
+    for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+    {
+        m_mineCartsProgressBar[i] = BG_SM_PROGRESS_BAR_NEUTRAL;
+        m_mineCartPathStage[i] = 0;
+        m_mineCartDepot[i] = SM_NO_DEPOT;
+        m_depotCloseTimer[i] = 0;
+    }
+
+    for (uint8 i = 0; i < SM_MAX_TRACK_SWITCH; ++i)
+    {
+        m_trackSwitchClickTimer[i] = 0;
+        m_trackSwitchOpened[i] = false;
+        m_trackSwitchCanInteract[i] = true;
+    }
+}
+
+bool BattlegroundSM::SetupBattleground()
+{
+    for (uint8 i = 0; i < SM_DEPOT_MAX; ++i)
+    {
+        if (!AddObject(BG_SM_OBJECT_WATERFALL_DEPOT + i, BG_SM_DepotEntries[i], BG_SM_DepotPos[i][0], BG_SM_DepotPos[i][1], BG_SM_DepotPos[i][2], BG_SM_DepotPos[i][3], 0, 0, 0, 0, RESPAWN_IMMEDIATELY))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundSM: Failed to spawn depot %u. Battleground not created!", uint32(i));
+            return false;
+        }
+    }
+
+    for (uint8 i = 0; i < 4; ++i)
+    {
+        if (!AddObject(BG_SM_OBJECT_DOOR_A_1 + i, BG_SM_DOOR, BG_SM_DoorPos[i][0], BG_SM_DoorPos[i][1], BG_SM_DoorPos[i][2], BG_SM_DoorPos[i][3], 0, 0, 0, 0, RESPAWN_IMMEDIATELY))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundSM: Failed to spawn door %u. Battleground not created!", uint32(i));
+            return false;
+        }
+
+        uint32 buffEntry = (i < 2) ? BG_OBJECTID_BERSERKERBUFF_ENTRY : BG_OBJECTID_REGENBUFF_ENTRY;
+        if (!AddObject(BG_SM_OBJECT_BERSERKING_BUFF_EAST + i, buffEntry, BG_SM_BuffPos[i][0], BG_SM_BuffPos[i][1], BG_SM_BuffPos[i][2], BG_SM_BuffPos[i][3], 0, 0, 0, 0, RESPAWN_IMMEDIATELY))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundSM: Failed to spawn buff %u. Battleground not created!", uint32(i));
+            return false;
+        }
+    }
+
+    for (uint8 i = 0; i < SM_MAX_TRACK_SWITCH; ++i)
+    {
+        Creature* trackSwitch = AddCreature(NPC_TRACK_SWITCH, SM_TRACK_SWITCH_EAST + i, 0, BG_SM_TrackPos[i][0], BG_SM_TrackPos[i][1], BG_SM_TrackPos[i][2], BG_SM_TrackPos[i][3]);
+        if (!trackSwitch)
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundSM: Failed to spawn track switch %u. Battleground not created!", uint32(i));
+            return false;
+        }
+
+        trackSwitch->CastSpell(trackSwitch, BG_SM_FEIGN_DEATH_STUN, true);
+    }
+
+    // The spirit guides stand where the teams start
+    for (uint8 team = TEAM_ALLIANCE; team <= TEAM_HORDE; ++team)
+    {
+        WorldSafeLocsEntry const* safeLoc = sWorldSafeLocsStore.LookupEntry(team == TEAM_ALLIANCE ? SM_GRAVEYARD_MAIN_ALLIANCE : SM_GRAVEYARD_MAIN_HORDE);
+        float x, y, z, o;
+        GetTeamStartLoc(team == TEAM_ALLIANCE ? ALLIANCE : HORDE, x, y, z, o);
+        if (!safeLoc || !AddSpiritGuide(SM_SPIRIT_ALLIANCE + team, safeLoc->x, safeLoc->y, safeLoc->z, o, team == TEAM_ALLIANCE ? ALLIANCE : HORDE))
+        {
+            SF_LOG_ERROR("bg.battleground", "BattlegroundSM: Failed to spawn spirit guide %u. Battleground not created!", uint32(team));
+            return false;
+        }
+    }
+
+    return true;
+}
+
+void BattlegroundSM::StartingEventCloseDoors()
+{
+    for (uint8 i = BG_SM_OBJECT_DOOR_A_1; i <= BG_SM_OBJECT_DOOR_H_2; ++i)
+    {
+        DoorClose(i);
+        SpawnBGObject(i, RESPAWN_IMMEDIATELY);
+    }
+
+    // The depots and the buffs only show up once the battle starts
+    for (uint8 i = BG_SM_OBJECT_WATERFALL_DEPOT; i < BG_SM_OBJECT_MAX; ++i)
+        SpawnBGObject(i, RESPAWN_ONE_DAY);
+}
+
+void BattlegroundSM::StartingEventOpenDoors()
+{
+    for (uint8 i = BG_SM_OBJECT_DOOR_A_1; i <= BG_SM_OBJECT_DOOR_H_2; ++i)
+        DoorOpen(i);
+
+    for (uint8 i = BG_SM_OBJECT_WATERFALL_DEPOT; i < BG_SM_OBJECT_MAX; ++i)
+        SpawnBGObject(i, RESPAWN_IMMEDIATELY);
+}
