+void BattlegroundSM::AddPlayer(Player* player)
+{
+    Battleground::AddPlayer(player);
+
+    PlayerScores[player->GetGUID()] = new BattlegroundSMScore();
+}
+
+void BattlegroundSM::PostUpdateImpl(uint32 diff)
+{
+    // The carts wait at their start while the players are still in the starting area
+    if (!m_mineCartsSpawned)
+    {
+        for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+            SpawnMineCart(i, false);
+
+        m_mineCartsSpawned = true;
+    }
+
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    // A captured cart is gone, the next one comes from the central depot
+    for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+        if (!GetMineCart(i))
+            SpawnMineCart(i, true);
+
+    if (m_mineCartCheckTimer <= int32(diff))
+    {
+        UpdateCartControl();
+        m_mineCartCheckTimer = IN_MILLISECONDS;
+    }
+    else
+        m_mineCartCheckTimer -= diff;
+
+    CheckMineCartNearDepot();
+    EventReopenDepot(diff);
+    MineCartAddPoints(diff);
+
+    for (uint8 i = 0; i < SM_MAX_TRACK_SWITCH; ++i)
+        CheckTrackSwitch(i, diff);
+
+    MineCartsMoves();
+}
+
+Creature* BattlegroundSM::GetMineCart(uint8 mineCart)
+{
+    return GetBgMap()->GetCreature(BgCreatures[NPC_SM_MINE_CART_1 + mineCart]);
+}
+
+void BattlegroundSM::SpawnMineCart(uint8 mineCart, bool announce)
+{
+    Creature* cart = AddCreature(BG_SM_CartIDs[mineCart], NPC_SM_MINE_CART_1 + mineCart, 0, BG_SM_StartPos[mineCart][0], BG_SM_StartPos[mineCart][1], BG_SM_StartPos[mineCart][2], BG_SM_StartPos[mineCart][3]);
+    if (!cart)
+        return;
+
+    cart->CastSpell(cart, BG_SM_CONTROL_VISUAL_NEUTRAL, true);
+    cart->SetUnitMovementFlags(MOVEMENTFLAG_BACKWARD);
+    cart->SetFlag(UNIT_FIELD_FLAGS, UNIT_FLAG_NOT_SELECTABLE);
+    cart->SetSpeed(MOVE_WALK, 0.8f);
+
+    m_mineCartsProgressBar[mineCart] = BG_SM_PROGRESS_BAR_NEUTRAL;
+    m_mineCartPathStage[mineCart] = 0;
+    m_mineCartDepot[mineCart] = SM_NO_DEPOT;
+
+    if (announce)
+    {
+        SendMessageToAll(LANG_BG_SM_MINE_CART_SPAWNED, ChatMsg::CHAT_MSG_BG_SYSTEM_NEUTRAL);
+        PlaySoundToAll(BG_SM_SOUND_MINE_CART_SPAWNED);
+    }
+}
+
+// The bar of a cart moves one step per second and player standing next to it, towards the team of the player
+void BattlegroundSM::UpdateCartControl()
+{
+    bool changed[SM_MINE_CART_MAX] = { };
+
+    for (BattlegroundPlayerMap::const_iterator itr = GetPlayers().begin(); itr != GetPlayers().end(); ++itr)
+    {
+        Player* player = ObjectAccessor::FindPlayer(itr->first);
+        if (!player || player->HasAuraType(SPELL_AURA_MOD_STEALTH))
+            continue;
+
+        bool nearCart = false;
+        if (player->IsAlive())
+        {
+            for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+            {
+                Creature* cart = GetMineCart(i);
+                if (!cart || !player->IsWithinDist(cart, float(BG_SM_CART_CONTROL_RANGE)))
+                    continue;
+
+                int32& progress = m_mineCartsProgressBar[i];
+                if (player->GetBGTeam() == ALLIANCE)
+                    progress = std::min<int32>(progress + 1, BG_SM_PROGRESS_BAR_MAX);
+                else
+                    progress = std::max<int32>(progress - 1, 0);
+
+                UpdateWorldStateForPlayer(SM_DISPLAY_PROGRESS_BAR, BG_SM_PROGRESS_BAR_SHOW, player);
+                UpdateWorldStateForPlayer(SM_PROGRESS_BAR_STATUS, progress, player);
+                changed[i] = true;
+                nearCart = true;
+                break;
+            }
+        }
+
+        if (!nearCart)
+            UpdateWorldStateForPlayer(SM_DISPLAY_PROGRESS_BAR, BG_SM_PROGRESS_BAR_DONT_SHOW, player);
+    }
+
+    for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+        if (changed[i])
+            UpdateCartVisual(i);
+}
+
+void BattlegroundSM::UpdateCartVisual(uint8 mineCart)
+{
+    Creature* cart = GetMineCart(mineCart);
+    if (!cart)
+        return;
+
+    uint32 keeper = GetMineCartTeamKeeper(mineCart);
+    uint32 visual = BG_SM_CONTROL_VISUAL_NEUTRAL;
+    if (keeper == ALLIANCE)
+        visual = BG_SM_CONTROL_VISUAL_ALLIANCE;
+    else if (keeper == HORDE)
+        visual = BG_SM_CONTROL_VISUAL_HORDE;
+
+    if (cart->HasAura(visual))
+        return;
+
+    cart->RemoveAurasDueToSpell(BG_SM_CONTROL_VISUAL_NEUTRAL);
+    cart->RemoveAurasDueToSpell(BG_SM_CONTROL_VISUAL_ALLIANCE);
+    cart->RemoveAurasDueToSpell(BG_SM_CONTROL_VISUAL_HORDE);
+    cart->CastSpell(cart, visual, true);
+
+    if (keeper == ALLIANCE)
+        SendMessageToAll(LANG_BG_SM_ALLIANCE_CONTROLLED_MINE_CART, ChatMsg::CHAT_MSG_BG_SYSTEM_ALLIANCE);
+    else if (keeper == HORDE)
+        SendMessageToAll(LANG_BG_SM_HORDE_CONTROLLED_MINE_CART, ChatMsg::CHAT_MSG_BG_SYSTEM_HORDE);
+}
+
+uint32 BattlegroundSM::GetMineCartTeamKeeper(uint8 mineCart) const
+{
+    if (m_mineCartsProgressBar[mineCart] > BG_SM_PROGRESS_BAR_NEUTRAL)
+        return ALLIANCE;
+
+    if (m_mineCartsProgressBar[mineCart] < BG_SM_PROGRESS_BAR_NEUTRAL)
+        return HORDE;
+
+    return 0;
+}
+
+void BattlegroundSM::CheckTrackSwitch(uint8 track, uint32 diff)
+{
+    Creature* trackSwitch = GetBgMap()->GetCreature(BgCreatures[SM_TRACK_SWITCH_EAST + track]);
+    if (!trackSwitch)
+        return;
+
+    if (m_trackSwitchCanInteract[track])
+    {
+        bool opened = trackSwitch->HasAura(BG_SM_TRACK_SWITCH_OPENED);
+        if (opened == m_trackSwitchOpened[track])
+            return;
+
+        SendMessageToAll(track == SM_EAST_TRACK_SWITCH ? LANG_BG_SM_EAST_DIRECTION_CHANGED : LANG_BG_SM_NORTH_DIRECTION_CHANGED, ChatMsg::CHAT_MSG_BG_SYSTEM_NEUTRAL);
+        m_trackSwitchOpened[track] = opened;
+        m_trackSwitchClickTimer[track] = BG_SM_TRACK_SWITCH_COOLDOWN;
+        m_trackSwitchCanInteract[track] = false;
+    }
+    else if ((m_trackSwitchClickTimer[track] -= diff) <= 0)
+    {
+        trackSwitch->RemoveAurasDueToSpell(BG_SM_PREVENTION_AURA);
+        m_trackSwitchCanInteract[track] = true;
+    }
+}
+
+// Switches are clicked through spell 97372 (see Spell::EffectDummy), the click flips the track
+void BattlegroundSM::EventPlayerClickedOnFlag(Player* player, Unit* target)
+{
+    if (GetStatus() != STATUS_IN_PROGRESS || !player || !target)
+        return;
+
+    if (target->GetEntry() != NPC_TRACK_SWITCH || target->HasAura(BG_SM_PREVENTION_AURA))
+        return;
+
+    target->CastSpell(target, BG_SM_PREVENTION_AURA, true);
+
+    if (target->HasAura(BG_SM_TRACK_SWITCH_OPENED))
+    {
+        target->RemoveAurasDueToSpell(BG_SM_TRACK_SWITCH_OPENED);
+        target->CastSpell(target, BG_SM_TRACK_SWITCH_CLOSED, true);
+    }
+    else
+    {
+        target->RemoveAurasDueToSpell(BG_SM_TRACK_SWITCH_CLOSED);
+        target->CastSpell(target, BG_SM_TRACK_SWITCH_OPENED, true);
+    }
+}
+
+void BattlegroundSM::MineCartsMoves()
+{
+    for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+    {
+        Creature* cart = GetMineCart(i);
+        if (!cart)
+            continue;
+
+        if (m_mineCartPathStage[i] == 0)
+        {
+            cart->GetMotionMaster()->MovePath(BG_SM_FirstLegPaths[i], false);
+            m_mineCartPathStage[i] = 1;
+            continue;
+        }
+
+        // The waterfall cart has a single leg, the other two choose their second leg at their track switch
+        if (m_mineCartPathStage[i] != 1 || i == BG_SM_MINE_CART_2)
+            continue;
+
+        uint8 track = (i == BG_SM_MINE_CART_1) ? SM_EAST_TRACK_SWITCH : SM_NORTH_TRACK_SWITCH;
+        if (cart->GetExactDist2d(BG_SM_TrackJunctionPos[track][0], BG_SM_TrackJunctionPos[track][1]) >= 0.5f)
+            continue;
+
+        Creature* trackSwitch = GetBgMap()->GetCreature(BgCreatures[SM_TRACK_SWITCH_EAST + track]);
+        if (!trackSwitch)
+            continue;
+
+        bool opened = trackSwitch->HasAura(BG_SM_TRACK_SWITCH_OPENED);
+        uint32 path;
+        if (track == SM_EAST_TRACK_SWITCH)
+            path = opened ? BG_SM_PATH_EAST_SWITCH_OPENED : BG_SM_PATH_EAST_SWITCH_CLOSED;
+        else
+            path = opened ? BG_SM_PATH_NORTH_SWITCH_OPENED : BG_SM_PATH_NORTH_SWITCH_CLOSED;
+
+        cart->GetMotionMaster()->Clear(true);
+        cart->GetMotionMaster()->MovePath(path, false);
+        m_mineCartPathStage[i] = 2;
+    }
+}
+
+void BattlegroundSM::CheckMineCartNearDepot()
+{
+    for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+    {
+        if (m_mineCartDepot[i] != SM_NO_DEPOT)
+            continue;
+
+        Creature* cart = GetMineCart(i);
+        if (!cart)
+            continue;
+
+        for (uint8 j = 0; j < 2; ++j)
+        {
+            uint8 depot = BG_SM_CartDepots[i][j];
+            if (depot == SM_NO_DEPOT)
+                continue;
+
+            if (cart->GetExactDist2d(BG_SM_DepotPos[depot][0], BG_SM_DepotPos[depot][1]) <= float(BG_SM_DEPOT_RANGE))
+            {
+                EventTeamCapturedMineCart(GetMineCartTeamKeeper(i), i, depot);
+                break;
+            }
+        }
+    }
+}
+
+// The cart stopped at a depot, the team keeping it gets the honor and the depot opens for a moment
+void BattlegroundSM::EventTeamCapturedMineCart(uint32 team, uint8 mineCart, uint8 depot)
+{
+    Creature* cart = GetMineCart(mineCart);
+    if (!cart)
+        return;
+
+    if (team)
+    {
+        for (BattlegroundPlayerMap::const_iterator itr = GetPlayers().begin(); itr != GetPlayers().end(); ++itr)
+        {
+            Player* player = ObjectAccessor::FindPlayer(itr->first);
+            if (!player || player->GetBGTeam() != team || !player->IsWithinDist(cart, float(BG_SM_CART_CONTROL_RANGE)))
+                continue;
+
+            UpdatePlayerScore(player, SCORE_CART_CONTROLLED, 1);
+            UpdatePlayerScore(player, SCORE_BONUS_HONOR, irand(10, 12));
+            player->UpdateAchievementCriteria(ACHIEVEMENT_CRITERIA_TYPE_BG_OBJECTIVE_CAPTURE, OBJECTIVE_CAPTURE_MINE_CART, 1);
+        }
+    }
+
+    cart->StopMoving();
+    if (GameObject* depotObject = GetBgMap()->GetGameObject(BgObjects[BG_SM_OBJECT_WATERFALL_DEPOT + depot]))
+        depotObject->UseDoorOrButton();
+
+    m_mineCartDepot[mineCart] = depot;
+    m_depotCloseTimer[mineCart] = BG_SM_DEPOT_CLOSE_TIME;
+}
+
+void BattlegroundSM::EventReopenDepot(uint32 diff)
+{
+    for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+    {
+        uint8 depot = m_mineCartDepot[i];
+        if (depot == SM_NO_DEPOT)
+            continue;
+
+        if ((m_depotCloseTimer[i] -= diff) > 0)
+            continue;
+
+        uint32 keeper = GetMineCartTeamKeeper(i);
+        m_mineCartDepot[i] = SM_NO_DEPOT;
+        m_mineCartsProgressBar[i] = BG_SM_PROGRESS_BAR_NEUTRAL;
+
+        if (GameObject* depotObject = GetBgMap()->GetGameObject(BgObjects[BG_SM_OBJECT_WATERFALL_DEPOT + depot]))
+            depotObject->ResetDoorOrButton();
+
+        DelCreature(NPC_SM_MINE_CART_1 + i);
+
+        if (keeper == ALLIANCE)
+        {
+            SendMessageToAll(LANG_BG_SM_ALLIANCE_CAPTURED_MINE_CART, ChatMsg::CHAT_MSG_BG_SYSTEM_ALLIANCE);
+            PlaySoundToAll(BG_SM_SOUND_MINE_CART_CAPTURED_ALLIANCE);
+        }
+        else if (keeper == HORDE)
+        {
+            SendMessageToAll(LANG_BG_SM_HORDE_CAPTURED_MINE_CART, ChatMsg::CHAT_MSG_BG_SYSTEM_HORDE);
+            PlaySoundToAll(BG_SM_SOUND_MINE_CART_CAPTURED_HORDE);
+        }
+
+        // Nobody kept the cart, no points
+        if (keeper)
+            AddPoints(keeper, BG_SM_POINTS_PER_MINE_CART);
+    }
+}
+
+// Every second each cart gives a point to the team keeping it
+void BattlegroundSM::MineCartAddPoints(uint32 diff)
+{
+    if (m_mineCartAddPointsTimer > diff)
+    {
+        m_mineCartAddPointsTimer -= diff;
+        return;
+    }
+
+    uint32 allianceCount = 0;
+    uint32 hordeCount = 0;
+    for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+    {
+        uint32 keeper = GetMineCartTeamKeeper(i);
+        if (keeper == ALLIANCE)
+            ++allianceCount;
+        else if (keeper == HORDE)
+            ++hordeCount;
+    }
+
+    m_mineCartAddPointsTimer = IN_MILLISECONDS;
+
+    if (allianceCount)
+        AddPoints(ALLIANCE, allianceCount);
+
+    if (hordeCount)
+        AddPoints(HORDE, hordeCount);
+}
+
+void BattlegroundSM::AddPoints(uint32 team, uint32 points)
+{
+    if (GetStatus() != STATUS_IN_PROGRESS)
+        return;
+
+    TeamId teamIndex = GetTeamIndexByTeamId(team);
+    m_TeamScores[teamIndex] = std::min<int32>(m_TeamScores[teamIndex] + points, BG_SM_MAX_TEAM_SCORE);
+    m_HonorScoreTics[teamIndex] += points;
+
+    if (m_HonorScoreTics[teamIndex] >= m_honorTicks)
+    {
+        RewardHonorToTeam(GetBonusHonorFromKill(6), team);
+        m_HonorScoreTics[teamIndex] -= m_honorTicks;
+    }
+
+    UpdateTeamScore(team);
+}
+
+void BattlegroundSM::UpdateTeamScore(uint32 team)
+{
+    uint32 score = m_TeamScores[GetTeamIndexByTeamId(team)];
+    if (!m_isInformedNearVictory && score >= BG_SM_WARNING_NEAR_VICTORY_SCORE)
+    {
+        SendMessageToAll(team == ALLIANCE ? LANG_BG_SM_A_NEAR_VICTORY : LANG_BG_SM_H_NEAR_VICTORY, ChatMsg::CHAT_MSG_BG_SYSTEM_NEUTRAL);
+        PlaySoundToAll(BG_SM_SOUND_NEAR_VICTORY);
+        m_isInformedNearVictory = true;
+    }
+
+    UpdateWorldState(team == ALLIANCE ? SM_ALLIANCE_RESOURCES : SM_HORDE_RESOURCES, score);
+
+    if (score >= BG_SM_MAX_TEAM_SCORE)
+        EndBattleground(team);
+}
+
+void BattlegroundSM::EndBattleground(uint32 winner)
+{
+    if (winner == ALLIANCE || winner == HORDE)
+    {
+        RewardHonorToTeam(GetBonusHonorFromKill(m_HonorWinKills), winner);
+
+        for (BattlegroundPlayerMap::const_iterator itr = GetPlayers().begin(); itr != GetPlayers().end(); ++itr)
+            if (itr->second.Team == winner)
+                if (Player* player = ObjectAccessor::FindPlayer(itr->first))
+                    player->KilledMonsterCredit(NPC_SILVERSHARD_MINES_CREDIT);
+    }
+
+    // Complete map_end rewards (even if no team wins)
+    RewardHonorToTeam(GetBonusHonorFromKill(m_HonorEndKills), ALLIANCE);
+    RewardHonorToTeam(GetBonusHonorFromKill(m_HonorEndKills), HORDE);
+
+    for (uint8 i = 0; i < SM_MINE_CART_MAX; ++i)
+        DelCreature(NPC_SM_MINE_CART_1 + i);
+
+    Battleground::EndBattleground(winner);
+}
+
+WorldSafeLocsEntry const* BattlegroundSM::GetClosestGraveYard(Player* player)
+{
+    return sWorldSafeLocsStore.LookupEntry(player->GetBGTeam() == ALLIANCE ? SM_GRAVEYARD_MAIN_ALLIANCE : SM_GRAVEYARD_MAIN_HORDE);
+}
+
+void BattlegroundSM::UpdatePlayerScore(Player* player, uint32 type, uint32 value, bool doAddHonor)
+{
+    BattlegroundScoreMap::iterator itr = PlayerScores.find(player->GetGUID());
+    if (itr == PlayerScores.end())
+        return;
+
+    switch (type)
+    {
+        case SCORE_CART_CONTROLLED:
+            ((BattlegroundSMScore*)itr->second)->MineCartCaptures += value;
+            break;
+        default:
+            Battleground::UpdatePlayerScore(player, type, value, doAddHonor);
+            break;
+    }
+}
+
+void BattlegroundSM::FillInitialWorldStates(WorldStateBuilder& builder)
+{
+    builder.AppendState(SM_MINE_CARTS_DISPLAY, DISPLAY_WORLDSTATE);
+    builder.AppendState(SM_ALLIANCE_RESOURCES, m_TeamScores[TEAM_ALLIANCE]);
+    builder.AppendState(SM_HORDE_RESOURCES, m_TeamScores[TEAM_HORDE]);
+    builder.AppendState(SM_MINE_CART_1, DISPLAY_WORLDSTATE);
+    builder.AppendState(SM_MINE_CART_2, DISPLAY_WORLDSTATE);
+    builder.AppendState(SM_DISPLAY_ALLIANCE_RESSOURCES, DISPLAY_WORLDSTATE);
+    builder.AppendState(SM_MINE_CART_3, DISPLAY_WORLDSTATE);
+    builder.AppendState(SM_DISPLAY_HORDE_RESSOURCES, DISPLAY_WORLDSTATE);
+    builder.AppendState(SM_DISPLAY_PROGRESS_BAR, BG_SM_PROGRESS_BAR_DONT_SHOW);     // shows the mine cart control bar
+    builder.AppendState(SM_PROGRESS_BAR_STATUS, BG_SM_PROGRESS_BAR_NEUTRAL);
+    builder.AppendState(SM_UNK, 0);
+}
